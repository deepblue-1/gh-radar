// ============================================================
// SYNC MARKER — 이 블록만 보면 동기화 상태를 알 수 있다
// server-repo-commit: 92cdfbff
// synced-date:        2026-10-06
// flatc-version:      25.12.19
// source:             server/src/protocol/StockDMA.fbs
// ============================================================
namespace StockDMA;

enum MsgType : byte {
    None = 0,

    // Client -> Server
    //   1~9:   기본 요청 (로그인, 주문, 계좌, 핑, 관찰자 로그인(5) — Phase 23)
    //   10~19: KRX 전략 설정 요청
    //   20~29: KRX 전략·계좌 상태 조회 요청
    //   27~29: 시세·마스터 요청 (Phase 15)
    //   30~38: 30/31 봉인(Phase 16 NXT-06 통합 — 재사용 금지) · 32 체결 테이프 · 33/34 VI 확인·목록 ·
    //          35 거래원 · 36/37 상따 매도·취소 래치 수동 점등 · 38 봉인(Phase 24 D-25)
    //   39:    전략 이벤트 백필 조회 (Phase 25)
    //   40:    일괄매도 (quick-261002-qvg)
    //   41~43: 자동매도 바로시작/중지 · 사용자 설정 저장/조회 (Phase 28)
    //   44:    원격 유저·계좌 관리 명령 — admin 관찰자(role 2) 전용 (Phase 29)
    LoginReq = 1,
    DirectOrderReq = 2,
    UpdateAccountNoReq = 3,
    LivePing = 4,
    ObserverLoginReq = 5,          // 관찰자(기록 전용) 로그인 (C→S, Phase 23 D-07/D-12, Envelope.observer_login_req)
                                   // 관찰자 연결은 5·4(LivePing) 외 요청을 전부 거부당한다 (D-12)
    SetLimitChaserReq = 10,
    SetVITriggerReq = 11,
    // 12/13: (예약) 구 SetAfterHourReq/SetAfterHourAuctionReq — 재사용 금지 (Phase 6 삭제)
    DisableStrategiesReq = 14,     // 세션 전략 일괄/단건 비활성화 (C→S, Phase 12 D-12)
    GetLimitChaserReq = 20,
    GetVITriggerReq = 21,
    // 22/23: (예약) 구 GetAfterHourReq/GetAfterHourAuctionReq — 재사용 금지 (Phase 6 삭제)
    GetLimitChaserListReq = 24,    // 세션 상따 전략 전수 열거 (C→S, Phase 12 D-02) — 요청 테이블 없음
    GetAccountStateReq = 25,       // 계좌 상태 스냅샷 조회 (C→S, Phase 13 D-05)
    ReconcileAccountStateReq = 26, // 원장 대사 업로드 (C→S, Phase 13 D-13)

    // === 이하 Phase 15 추가 (시세·마스터 요청 — 빈 대역 27~29 에 배치) ===
    // enum 값은 명시 상수이고 flatc 는 오름차순 선언을 요구하므로 번호 순서대로 적는다.
    // 기존 번호는 하나도 바뀌지 않는다 (wire 불변).
    GetSymbolMasterReq = 27,       // 종목마스터 전량 다운로드 요청 (C→S, Phase 15 D-13) — 요청 테이블 없음
                                   // (GetLimitChaserListReq(24) 선례 — 인자가 없는 요청은 테이블을 만들지 않는다)
    GetQuoteReq = 28,              // 시세 스냅샷 조회 (C→S, Phase 15 D-07)
    SubscribeQuoteReq = 29,        // 종목 시세 구독/해제 (C→S, subscribe=false 가 해제 — Phase 15 D-05)

    // NXT 전략 — 별도 번호를 배선하지 않는다 (값만 남긴다)
    SetLimitChaserNXTReq = 30,     // (예약 봉인) 10/20/60 의 exchange 로 통합 — 재사용 금지 (Phase 16 NXT-06)
    GetLimitChaserNXTReq = 31,     // (예약 봉인) 10/20/60 의 exchange 로 통합 — 재사용 금지 (Phase 16 NXT-06)

    // 32~33 은 NXT 전략이 쓰지 않는 빈 번호였다 — Phase 15 시세가 32 를 쓴다 (CONTEXT 재량 범위)
    GetTradeTapeReq = 32,          // 체결 테이프 스냅샷 조회 (C→S, Phase 15 D-02)

    // === 이하 quick-260903-m2c 추가 (VI 자동취소 서버 이관 — 빈 대역 33~ 에 오름차순 배치) ===
    ConfirmVIOrderReq = 33,        // VI 자동주문 확인 체크 등록/해제 (C→S, D-03/D-09) — 119초 미확인 취소 면제
    GetVIOrderListReq = 34,        // VI 추적 목록 스냅샷 조회 (C→S, D-06/D-18) — 요청 테이블 없음 (24/27 선례)

    // === 이하 quick-260904-fi6 추가 (거래원 — 회원사별 매도5·매수5 매매 통계, KRX/NXT B9 원천) ===
    GetMemberStatsReq = 35,        // 거래원 스냅샷 조회 (C→S) — 요청 테이블은 get_quote_req 슬롯 재사용
                                   // (20~23 이 GetStrategyReq 를 공유하는 선례 — 인자가 isin+exchange 로 같다)

    // === 이하 quick-260909-ka9 추가 (상따 매도 진입 확인 래치 수동 점등) ===
    ArmSellLatchReq = 36,          // 매도 진입 확인 래치 수동 점등 (C→S, quick-260909-ka9 D-05)
                                   // 요청 테이블은 get_strategy_req 슬롯 재사용(35 선례),
                                   // 응답은 SetLimitChaserResp(60) 에코다 — 응답 전용 번호를 만들지 않는다 (D-07)

    // === 이하 quick-260910-kel 추가 (상따 취소 진입 확인 래치 수동 점등) ===
    ArmCancelLatchReq = 37,        // 취소 진입 확인 래치 수동 점등 (C→S, quick-260910-kel D-03)
                                   // 요청 테이블은 get_strategy_req 슬롯 재사용(35·36 선례),
                                   // 응답은 SetLimitChaserResp(60) 에코다 — 응답 전용 번호를 만들지 않는다 (D-03)

    // === 이하 quick-260910-ttc 추가 (상따 매수 진입 확인 래치 수동 점등) ===
    ArmBuyLatchReq = 38,          // (예약 봉인) 매수 진입 래치 폐기 — 재사용 금지 (Phase 24 D-25, 서버는 ERROR 로 거부)
                                   // 구 클라가 보낼 수 있어 값은 남긴다(append-only). 요청 테이블은 get_strategy_req 슬롯이었다.

    // === 이하 Phase 25 추가 (상따 주문로그·잔량진행률 — 25-HANDOFF-gh-radar-fields-v0.1, D-01/D-03) ===
    GetStrategyEventsReq = 39,     // 전략 이벤트 오늘분 백필 조회 (C→S, Phase 25 D-07) — 요청 테이블은 get_quote_req 슬롯
                                   // 재사용(35 선례, isin + exchange). exchange "" = 전 거래소. 응답은 81 StrategyEventsResp

    // === 이하 quick-261002-qvg 추가 (상따창 일괄매도 — D-01/D-02/D-05) ===
    BulkSellReq = 40,              // 상따창 일괄매도 (C→S) — 그 계좌·종목의 매수 미체결(KRX·NXT) 전량 취소 +
                                   // 서버 매도가능수량 전량을 요청 가격·거래소로 매도한다.
                                   // 요청 테이블은 direct_order_req 슬롯 재사용(35 선례) — stock_code·account_no·price·
                                   // market·exchange 만 읽고 side·quantity·order_type 등은 무시한다(대상·수량은 서버 원장).
                                   // 응답 번호 없음 — 건별은 51 OrderResp, 요약 1줄은 54 ServerMessage(source "DirectOrder").
                                   // 예약 구간(77 open)의 KRX 매도 요청은 서버가 거부한다(D-05 — NXT 요청은 통과).

    // === 이하 Phase 28 추가 (자동매도 — 28-CONTEXT D-19/D-20/D-25/D-26, 28-HANDOFF §2·§3) ===
    AutoSellCommandReq = 41,       // 자동매도 바로시작/중지 (C→S, D-19) — Envelope.auto_sell_command_req 슬롯 86.
                                   // 응답 번호 없음 — 성공은 SetLimitChaserResp(60) 에코(상태 변화), 실패는 54 ERROR
                                   // source "AutoSellCommand" + isin (D-25). Set 의 one-shot 필드로 두지 않는 이유는
                                   // 확정마다 전체 재제출(lc.set)에 다시 실려 재발화하기 때문이다(HANDOFF §0).
    SetUserSettingsReq = 42,       // 사용자 설정 저장 (C→S, D-20) — Envelope.user_settings 슬롯 88(84 와 공유, 81/82 선례).
                                   // 응답 = 84 UserSettingsResp — 같은 dma_user_id 전 세션 Notice 브로드캐스트 (D-26).
                                   // 범위 밖 값은 54 ERROR 로 거부하고 저장값은 바꾸지 않는다.
    GetUserSettingsReq = 43,       // 사용자 설정 조회 (C→S, D-20) — 요청 테이블 없음(24/27/34 선례). 응답 = 84 요청 연결 Notice

    // === 이하 Phase 29 추가 (원격 유저·계좌 관리 — 29-CONTEXT D-04/D-05, gh-radar-34 합의) ===
    AdminCommandReq = 44,          // 원격 유저·계좌 관리 명령 (C→S) — admin 관찰자(ObserverLoginReq.role 2) 연결 전용.
                                   // op 1~5 (AdminCommandReq 테이블 주석) · Envelope.admin_command_req 슬롯 92.
                                   // 응답 = 86 AdminCommandResp (+ 실제 변경이면 87 AdminUsersSnapshot 1회).
                                   // 사용자 세션 연결이 보내면 86 code 11(NOT_ADMIN)

    // Server -> Client
    //   50~59: 기본 응답 (로그인, 주문, 체결, 메시지, 계좌)
    //   60~69: KRX 전략·계좌 상태 응답
    //   70~83: 70 봉인(Phase 16 NXT-06 통합 — 재사용 금지) · 71 테이프 증분 · 72/73 VI 목록 ·
    //          74/75 거래원 · 76 등락률 돌파 · 77 예약 구간 상태 · 78 돌파 스냅샷 ·
    //          79/80 관찰자 로그인 응답·주문 저널 (Phase 23) ·
    //          81/82 전략 이벤트 백필·푸시 · 83 잔량진행률 (Phase 25)
    //   84:    사용자 설정 응답·푸시 (Phase 28)
    //   85:    실시간 상한가 특징 푸시 (Phase 27)
    //   86~87: 원격 유저·계좌 관리 응답·전체 목록 (Phase 29 — admin 관찰자 연결 전용)
    LoginResp = 50,
    OrderResp = 51,
    OrderConfirm = 52,
    TradeExecution = 53,
    ServerMessage = 54,
    UpdateAccountNoResp = 55,
    VIOrderNotice = 56,      // VI 자동주문 발주 통지 (S→C, 발주 성공 1건/주문 — Phase 11.1 D-14)

    // === 이하 Phase 15 추가 (시세·마스터 응답·푸시 — 빈 대역 57~59 에 배치) ===
    SymbolMasterResp = 57,         // 종목마스터 분할 응답 (S→C, is_last=true 가 마지막 프레임 — Phase 15 D-13)
    GetQuoteResp = 58,             // 시세 스냅샷 응답 (S→C, is_snapshot=true — Phase 15 D-07)
    QuoteUpdate = 59,              // 시세 증분 푸시 (S→C, is_snapshot=false, 100ms 코얼레싱 — Phase 15 D-06/D-08)
                                   // 58/59 는 Envelope 의 quote_state 슬롯 **하나를** 공유한다 (66/67 선례)

    SetLimitChaserResp = 60,
    SetVITriggerResp = 61,
    // 62/63: (예약) 구 SetAfterHourResp/SetAfterHourAuctionResp — 재사용 금지 (Phase 6 삭제)
    GetLimitChaserListResp = 64,   // 상따 전략 전수 열거 응답 (S→C, Phase 12 D-02)
    DisableStrategiesResp = 65,    // 전략 비활성화 집계 (S→C, Phase 12 D-12)
    GetAccountStateResp = 66,      // 계좌 상태 스냅샷 응답 (S→C, is_snapshot=true, 계좌당 1프레임 — Phase 13 D-05)
    AccountStateDelta = 67,        // 계좌 상태 증분 푸시 (S→C, is_snapshot=false — Phase 13 D-02/D-06)
    ReconcileAccountStateResp = 68,// 원장 대사 집계 (S→C, 요청 연결에만 — Phase 13 D-13)

    // Phase 15 — 체결 테이프 스냅샷 (69 는 60번대 마지막 빈 번호)
    TradeTapeResp = 69,            // 체결 테이프 스냅샷 응답 (S→C, is_snapshot=true — Phase 15 D-02)

    // NXT 전략 응답 — 별도 번호를 배선하지 않는다 (값만 남긴다)
    SetLimitChaserNXTResp = 70,    // (예약 봉인) 10/20/60 의 exchange 로 통합 — 재사용 금지 (Phase 16 NXT-06)

    // Phase 15 — 체결 테이프 증분 푸시 (69 와 trade_tape 슬롯을 공유한다)
    TradeTapePush = 71,            // 체결 테이프 증분 푸시 (S→C, is_snapshot=false — Phase 15 D-02)

    // quick-260903-m2c — VI 추적 목록 (72/73 은 Envelope 의 vi_order_list 슬롯 **하나를** 공유한다, 66/67 선례)
    GetVIOrderListResp = 72,       // VI 추적 목록 스냅샷 응답 (S→C, is_snapshot=true, 요청 연결에만)
    VIOrderListPush = 73,          // VI 추적 항목 변경 푸시 (S→C, is_snapshot=false, 같은 user 전 연결 Notice)

    // quick-260904-fi6 — 거래원 (74/75 는 Envelope 의 member_stats 슬롯 **하나를** 공유한다, 69/71 선례)
    MemberStatsResp = 74,          // 거래원 스냅샷 응답 (S→C, is_snapshot=true, 요청 연결에만 Notice — 보유 없으면 빈 벡터)
    MemberStatsPush = 75,          // 거래원 증분 푸시 (S→C, is_snapshot=false, 시세 구독(m_subs) 편승 Broadcast)

    // Phase 19 — 등락률 임계 상향 돌파 푸시 (푸시 전용·요청 짝 없음·접속 연결 전부 Broadcast — 하루 1회 규칙은 클라 몫, D-07)
    RateCrossAlert = 76,           // 등락률 임계 상향 돌파 알림 (S→C, Envelope.rate_cross_alert 슬롯, 스냅샷 플래그 없음 — D-09/D-10)

    // Phase 18.1 G5/G6 — 예약 구간 상태 (Envelope 의 queued_window_state 슬롯)
    // 76 은 Phase 19 RateCrossAlert 가 먼저 배포돼 77 로 재번호했다 (quick-260913-kia, append-only)
    QueuedWindowState = 77,        // 예약 구간 상태 푸시 (S→C — 로그인 직후 그 연결 + open 전이 시 전 세션 Notice, 표시 전용)

    // quick-260914-eqd — 등락률 돌파 스냅샷 (Envelope 의 rate_cross_snapshot 슬롯)
    RateCrossSnapshot = 78,        // 등락률 돌파 스냅샷 (S→C, 로그인 성공 직후 그 연결에만 Notice, Envelope.rate_cross_snapshot — quick-260914-eqd)

    // Phase 23 — 관찰자(기록 전용) 연결 · 주문 저널 (gh-radar 19 인계서 §2, D-07)
    ObserverLoginResp = 79,        // 관찰자 로그인 응답 (S→C, 요청 연결에만 Notice, Envelope.observer_login_resp)
    JournalBatch = 80,             // 주문 저널 배치 (S→C, 관찰자 연결에만 Notice + 펌프 스로틀, Envelope.journal_batch)

    // Phase 25 — 상따 주문로그·잔량진행률 (25-HANDOFF-gh-radar-fields-v0.1, D-01/D-07/D-19)
    // 81/82 는 Envelope 의 strategy_event_batch 슬롯 **하나를** 공유한다 (66/67 선례, vtable 슬롯 82)
    StrategyEventsResp = 81,       // 전략 이벤트 오늘분 백필 응답 (S→C, is_snapshot=true, 요청 연결에만 Notice — D-07)
    StrategyEventPush = 82,        // 전략 이벤트 푸시 (S→C, is_snapshot=false, events 1건, 접속 연결 Notice — D-07)
    QueueProgress = 83,            // 잔량진행률 (S→C, Envelope.queue_progress 슬롯 84, 종목·거래소별 1초 스로틀 Broadcast — D-19)

    // Phase 28 — 사용자 설정 (28-CONTEXT D-20/D-26, 28-HANDOFF §3)
    UserSettingsResp = 84,         // 사용자 설정 (S→C, Envelope.user_settings 슬롯 88 — 42 요청과 공유) — 로그인 직후 그 연결에
                                   // Notice 1프레임(77/78 패턴) + 42 Set 뒤 같은 dma_user_id 로 묶인 전 세션 Notice 브로드캐스트 +
                                   // 43 Get 응답(요청 연결). present=false 면 서버 저장값 없음(내장 기본값을 싣는다, D-20)

    // Phase 27 — 실시간 상한가 특징 (푸시 전용·요청 짝 없음·FULL 구독(m_subs) 편승 Broadcast, D-17/D-18).
    // 84·86·88·kind 11~14 는 Phase 28 이 먼저 고정했다 — 85 · Envelope 슬롯 90 · kind 15 는 그 뒤 append.
    LimitFeature = 85,             // 실시간 상한가 특징 (S→C, Envelope.limit_feature 슬롯 90, 키(isin, 거래소)별 1초 스로틀 Broadcast —
                                   // 그 키를 FULL 구독한 연결에만, 75 선례). 필드 정본 docs/analysis/feature-dictionary.md 「85 필드」 열

    // === 이하 Phase 29 추가 (원격 유저·계좌 관리 — 29-CONTEXT D-04~D-07, gh-radar-34 합의) ===
    AdminCommandResp = 86,         // 44 응답 (S→C, Envelope.admin_command_resp 슬롯 94, 요청 연결에만 Notice) — code 표는 테이블 주석
    AdminUsersSnapshot = 87        // users.toml 전체 목록 (S→C, Envelope.admin_users_snapshot 슬롯 96, 요청 연결에만 Notice) —
                                   // op 5 응답 · 변경 op 가 실제 변경을 낸 뒤 86 다음 1회. 비밀번호 없음 (D-06/D-07)
}

// ============================================================================
// Client -> Server 기본 요청
// ============================================================================

// 로그인 요청
table LoginReq {
    user_id: string;      // 사용자 ID
    password: string;     // 비밀번호. **Phase 17 부터 서버가 config/users.toml 과 대조한다
                          // (D-02) — 브로커 종류와 무관**. 그 전까지는 서버가 읽지 않았다

    // === 이하 Phase 9 추가 (테이블 **말미 append** — 기존 필드 순서 불변, 하위호환) ===
    // FlatBuffers 는 선언 순서로 field id 를 매긴다. 가운데 삽입/삭제는 wire 를 깨서
    // 미업그레이드 클라이언트가 엉뚱한 필드를 읽는다. 신규 필드는 반드시 여기 아래에만 붙인다.

    broker: string;       // 브로커 구분 "KB" / "KYOBO" (대소문자 무시). **미지정·미지원 값·
                          // 서버 [broker].name 불일치는 로그인 거부** (D-11/D-12/D-13,
                          // mock 서버는 전부 허용). 인증이 아니다 — 전략 공간 선택 키다
}

// 수동 주문 요청
table DirectOrderReq {
    stock_code: string;       // ISIN 코드 (12자리)
    account_no: string;       // 계좌번호 (최대 12자리)
    side: string;             // 매수/매도 ("B"=매수, "S"=매도)
    price: int;               // 주문가격 (원)
    quantity: int;            // 주문수량 (주). 취소 시에는 취소수량 = 원주문 미체결 잔량 —
                              // 0 은 전량취소가 아니라 즉시 거부다 (D-44)
    order_condition: string;  // 주문조건 ("0"=보통, "1"=IOC, "2"=FOK)
    market: string;           // 시장구분 ("K"=KOSPI, "Q"=KOSDAQ)
    exchange: string;         // 거래소 ("KRX" or "NXT")
                              // ★ Phase 16 — **서버가 읽는다**. 빈 값(구 클라)은 "KRX" 로 정규화.
                              //   정정·취소도 원주문 거래소를 싣되, 서버 브로커는 원주문 메타
                              //   (OrderMetaTable)에 보관한 거래소를 **우선**한다 — 클라가 잘못
                              //   실어도 원주문과 다른 거래소로 정정·취소가 나가지 않는다.
                              //   "NXT" ∧ NXT 미거래 종목이면 즉시 실패 OrderResp(notice_type="R") (D-04)

    // === 이하 quick-260824 추가 (테이블 **말미 append** — 기존 필드 순서 불변, 하위호환) ===
    // FlatBuffers 는 선언 순서로 field id 를 매긴다. 가운데 삽입/삭제는 wire 를 깨서
    // 미업그레이드 클라이언트가 엉뚱한 필드를 읽는다. 신규 필드는 반드시 여기 아래에만 붙인다.

    order_type: string;       // 주문유형 ("N"=신규, "M"=정정, "C"=취소). **미지정이면 신규** —
                              // 구 C# 클라이언트가 보내는 메시지에는 이 필드가 없으므로
                              // 기존 신규주문 경로가 바이트 하나 바뀌지 않는다
    org_order_no: string;     // 원주문번호 (10자리, order_type="M"/"C" 일 때 필수)

    // === 이하 Phase 18.1 추가 (테이블 **말미 append** — 기존 필드 순서 불변, 하위호환) ===

    piece_count: uint;        // 16:00 예약 발사 조각 수 (18.1 D-17).
                              // **0/미지정 = 1** — 구 C# 클라이언트는 이 필드를 보내지
                              //   않으므로 기존 수동주문 경로가 바이트 하나 바뀌지 않는다.
                              // 서버 상한은 설정값 [queued_order] max_pieces (기본 10,
                              //   허용 1..64) — 초과는 브로커에 닿기 전에 거부다.
                              // **예약 구간(15:20~16:00 KRX 신규) 밖에서는 무시한다** —
                              //   정규장·애프터마켓 즉시 발주는 종전대로 1건이다.

    // === 이하 Phase 18.2 추가 (테이블 **말미 append** — 기존 필드 순서 불변, 하위호환) ===

    krx_session: string;      // KRX 시간외종가 세션 지정 (18.2 D-12).
                              // **"" / 부재 = 서버 자동 판정** (18 D-04 종전) — 구 C# 클라이언트는
                              //   이 필드를 보내지 않으므로 기존 수동주문 경로가 바이트 하나 바뀌지 않는다.
                              // "G2" = 장개시전 시간외종가 · "G3" = 장종료후 시간외종가.
                              // 값이 있으면 예약(15:20~16:00)·장전 G1 판정을 타지 않는다 (18.2 D-12).
                              // 그 외 값은 브로커에 닿기 전에 즉시 거부다 (18.2-05).
}

// 계좌번호 관리 요청
table UpdateAccountNoReq {
    mode: string;         // "0"=삭제, "1"=추가, "2"=조회
    account_no: string;   // 계좌번호
}

// 핑 (연결 유지)
table LivePing {
    ping_time: uint;      // 클라이언트 타임스탬프 (초)
}

// ============================================================================
// Server -> Client 기본 응답
// ============================================================================

// 허용 계좌 1건 (LoginResp.accounts 원소, Phase 17 D-19).
// 지점번호/거래자ID 는 서버 내부(KB 주문 전문 TCHODR1000) 전용이라 와이어에 싣지 않는다.
table AccountEntry {
    account_no: string;   // 계좌번호 — users.toml 표기 그대로 (앞 0 없이, 최대 12자)
    name: string;         // 계좌명 — 클라 계좌 선택창 표시용
}

// 로그인 응답
table LoginResp {
    success: bool;        // 성공 여부
    message: string;      // 결과 메시지 — 거부는 단일 문구
                          // "아이디 또는 비밀번호가 올바르지 않습니다" (D-04)

    // === 이하 Phase 17 추가 (테이블 **말미 append** — 기존 필드 순서 불변, 하위호환) ===
    // FlatBuffers 는 선언 순서로 field id 를 매긴다. 가운데 삽입/삭제는 wire 를 깨서
    // 미업그레이드 클라이언트가 엉뚱한 필드를 읽는다. 신규 필드는 반드시 여기 아래에만 붙인다.

    accounts: [AccountEntry];   // 이 사용자의 허용 계좌, priority 오름차순 (D-08).
                                // 실패 응답과 mock 무인증 로그인은 **빈 벡터**다 (D-19)
}

// 주문 결과 응답
table OrderResp {
    // ★ Phase 11 슬롯(client_key) 제거 — 필드를 **지우지 않고** (deprecated) 로 봉인한다.
    //   FlatBuffers 는 테이블 필드 id 를 **선언 순서로** 부여하므로 가운데 필드를 지우면
    //   뒤 필드의 슬롯이 전부 한 칸씩 밀린다. 그러면 아직 갱신되지 않은 클라이언트가 보낸
    //   메시지를 서버가 엉뚱한 필드로 읽는다 — 실계좌에서 그대로 오주문이다.
    //   deprecated 필드는 접근자가 생성되지 않으므로 코드에서는 이미 사라진 것과 같다.
    slot_id: int (deprecated);   // (봉인) 구 전략 슬롯 ID — 슬롯 개념 폐기, origin 으로 대체 (D-02/D-03)
    stock_code: string;   // ISIN 코드
    side: string;         // 매수/매도. **취소·정정 통보에서는 표시용으로 신뢰할 수 없다** —
                          // 취소·정정 요청 자체에 매매구분이 없어 브로커가 원주문을 찾지 않는 한
                          // 채울 값이 없다(MockBroker 는 "B" 로 남긴다). 클라는 notice_type
                          // 이 "C"/"M" 이면 매수/매도 대신 "취소"/"정정" 을 표기한다
    order_no: string;     // 주문번호
    result_code: int;     // 결과코드 (0=성공, 그 외=거부코드)
    price: int;           // 주문가격
    quantity: int;        // 주문수량
    message: string;      // 결과 메시지 (거부 사유 등)

    // === 이하 Phase 10 추가 (테이블 **말미 append** — 기존 필드 순서 불변, 하위호환) ===
    // FlatBuffers 는 선언 순서로 field id 를 매긴다. 가운데 삽입/삭제는 wire 를 깨서
    // 미업그레이드 클라이언트가 엉뚱한 필드를 읽는다. 신규 필드는 반드시 여기 아래에만 붙인다.

    notice_type: string;  // 통보 종류 "A"=접수 "E"=체결 "C"=취소확인 "M"=정정확인 "R"=거부
                          // (IBroker.h ExecutionReport.noticeType 그대로). Gateway 즉시 실패
                          // 회신은 "R". **미지정(구 서버)이면 클라는 result_code/quantity
                          // 로만 판정한다** — 필드 부재를 오류로 다루지 않는다 (D-04)
    org_order_no: string; // 원주문번호 — 정정확인/취소확인, 그리고 정정·취소 요청의 즉시
                          // 실패에서 채운다. 신규주문 통보는 "" (빈 문자열)

    // === 이하 Phase 11 추가 (테이블 **말미 append** — 기존 필드 순서 불변, 하위호환) ===
    // FlatBuffers 는 선언 순서로 field id 를 매긴다. 가운데 삽입/삭제는 wire 를 깨서
    // 미업그레이드 클라이언트가 엉뚱한 필드를 읽는다. 신규 필드는 반드시 여기 아래에만 붙인다.

    origin: string;       // 발주 주체 "Manual" / "LimitChaser" / "VITrigger".
                          // **미지정(구 서버)이면 클라는 태그를 생략한다** — 필드 부재를
                          // 오류로 다루지 않는다 (D-03)

    // === 이하 Phase 16 추가 (테이블 **말미 append** — 기존 필드 순서 불변, 하위호환) ===
    // FlatBuffers 는 선언 순서로 field id 를 매긴다. 가운데 삽입/삭제는 wire 를 깨서
    // 미업그레이드 클라이언트가 엉뚱한 필드를 읽는다. 신규 필드는 반드시 여기 아래에만 붙인다.

    exchange: string;     // 거래소 "KRX" / "NXT". **미지정(구 서버)이면 클라는 KRX 로 열화하고
                          // 태그를 생략한다** — 필드 부재를 오류로 다루지 않는다.
                          // D-11 의 종목명 뒤 [NXT] 태그는 이 필드 하나로 성립한다. 체결 통보도
                          // 이 테이블로 온다 (notice_type="E") — TradeExecution(53) 이 아니다

    // === 이하 Phase 18.2 추가 (테이블 **말미 append** — 기존 필드 순서 불변, 하위호환) ===

    board: string;        // 통보 보드 — UnfilledState.board 와 같은 규칙 (18.2 D-19).
                          // **"G2"/"G3" 만 싣는다 — G1·G4·미상은 ""**. 원천은 브로커 수신 전문의
                          // boardId(ExecutionReport.board). 구 서버는 부재 = "" 로 읽는다

    // === 이하 quick-260917-lmm 추가 (테이블 말미 append) ===

    request_kind: string; // 이 통보가 답하는 요청 "New" / "Modify" / "Cancel". 미상·구 서버 "".
                          // 거부 줄의 행위 단어("취소"/"정정") 원천 — 클라는 message 문구를 해석하지
                          // 않는다. 원천은 브로커 수신 전문의 정정취소구분(ExecutionReport.requestKind).
                          // 정정·취소 804 거부는 서버가 message 를 친화 문구로 교체해 싣는다
    requester: string;    // 정정·취소를 사람이 요청했으면 "Manual", 그 밖 "". **표시 전용** —
                          // origin 은 원주문 주체 그대로다(D-03: 사람이 낸 상따 주문 취소도 origin
                          // "LimitChaser"). 구 서버는 부재 = "" 로 읽는다
}

// 주문 접수 확인
table OrderConfirm {
    order_no: string;     // 주문번호
    sender: string;       // 주문 발신자
}

// 계좌번호 조회 응답
table UpdateAccountNoResp {
    account_list: [string];  // 등록된 계좌번호 목록
}

// 체결 통보
table TradeExecution {
    // ★ Phase 11 슬롯(client_key) 제거 — 필드를 **지우지 않고** (deprecated) 로 봉인한다.
    //   FlatBuffers 는 테이블 필드 id 를 **선언 순서로** 부여하므로 가운데 필드를 지우면
    //   뒤 필드의 슬롯이 전부 한 칸씩 밀린다. 그러면 아직 갱신되지 않은 클라이언트가 보낸
    //   메시지를 서버가 엉뚱한 필드로 읽는다 — 실계좌에서 그대로 오주문이다.
    //   deprecated 필드는 접근자가 생성되지 않으므로 코드에서는 이미 사라진 것과 같다.
    slot_id: int (deprecated);   // (봉인) 구 전략 슬롯 ID — 슬롯 개념 폐기 (D-02)
    stock_code: string;    // ISIN 코드
    side: string;          // 매수/매도
    order_no: string;      // 주문번호
    executed_price: int;   // 체결가격 (원)
    executed_qty: int;     // 체결수량 (주)

    // === 이하 Phase 16 추가 (테이블 **말미 append** — 기존 필드 순서 불변, 하위호환) ===
    // FlatBuffers 는 선언 순서로 field id 를 매긴다. 가운데 삽입/삭제는 wire 를 깨서
    // 미업그레이드 클라이언트가 엉뚱한 필드를 읽는다. 신규 필드는 반드시 여기 아래에만 붙인다.

    exchange: string;      // 거래소 "KRX" / "NXT" — **스키마 정합용 append 다.**
                           // 서버에 이 테이블을 만드는 경로가 없다 (체결 통보는 OrderResp 의
                           // notice_type="E" 로 온다). 런타임 소비자가 없으므로 클라 파싱을
                           // 추가하지 않는다 — 51 과 슬롯 규약을 맞추기 위해서만 둔다
}

// 서버 메시지 (알림, 경고 등)
table ServerMessage {
    level: string;        // "INFO", "WARN", "ERROR"
    message: string;      // 메시지 내용

    // === 이하 Phase 10 추가 (테이블 **말미 append** — 기존 필드 순서 불변, 하위호환) ===
    // FlatBuffers 는 선언 순서로 field id 를 매긴다. 가운데 삽입/삭제는 wire 를 깨서
    // 미업그레이드 클라이언트가 엉뚱한 필드를 읽는다. 신규 필드는 반드시 여기 아래에만 붙인다.

    isin: string;         // 관련 종목 ISIN. **비면 브로드캐스트**(시세·브로커 경보 등
                          // 특정 종목에 매이지 않은 통지) — 클라는 빈 값을 종목 미지정으로
                          // 취급해 전 폼에 띄운다 (클라 D-10)
    account_no: string;   // 관련 계좌번호 (요청을 보낸 그 연결에만 되돌린다 — 타 연결로 새지 않음)
    // ★ Phase 11 슬롯(client_key) 제거 — 필드를 **지우지 않고** (deprecated) 로 봉인한다.
    //   FlatBuffers 는 테이블 필드 id 를 **선언 순서로** 부여하므로 가운데 필드를 지우면
    //   뒤 필드의 슬롯이 전부 한 칸씩 밀린다. 그러면 아직 갱신되지 않은 클라이언트가 보낸
    //   메시지를 서버가 엉뚱한 필드로 읽는다 — 실계좌에서 그대로 오주문이다.
    //   deprecated 필드는 접근자가 생성되지 않으므로 코드에서는 이미 사라진 것과 같다.
    slot_id: int (deprecated);   // (봉인) 구 전략 슬롯 = client_key — 슬롯 개념 폐기 (D-02)
    source: string;       // 발신 맥락 "SetLimitChaser" / "SetVITrigger" / "Account" / "System"
                          // ("DirectOrder" 는 예약값 — 수동주문 실패는 전부 OrderResp rc<0
                          //  로 회신하므로 현재 발신자가 없다)
                          // "LimitChaser" = 상따 발주·취소·인수 사유 줄 · "VITrigger" = VI 자동취소
                          // 사유 줄 (quick-260917-lmm — 클라 배지 [상따]/[VI] 의 원천, 동등 비교)
                          // "AutoSell" = 자동매도 사유 줄(54 INFO) · "AutoSellCommand" = 바로시작/중지 실패
                          // (54 ERROR, isin 동반) (Phase 28 D-25, 28-HANDOFF §2·§4-1)

    // === 이하 Phase 11 추가 (테이블 **말미 append** — 기존 필드 순서 불변, 하위호환) ===
    // FlatBuffers 는 선언 순서로 field id 를 매긴다. 가운데 삽입/삭제는 wire 를 깨서
    // 미업그레이드 클라이언트가 엉뚱한 필드를 읽는다. 신규 필드는 반드시 여기 아래에만 붙인다.

    kind: string;         // 사건 종류 "SessionJoin" / "Restore" / "Purge". 그 외에는 빈 값.
                          // 클라가 **문구를 해석하지 않고** 통지 성격을 판별하는 근거다 (D-11)
}

// ============================================================================
// 전략 설정 (Client -> Server, Server -> Client 공용)
// ============================================================================

// LimitChaser (상따) 전략 설정
// - 주식 가격이 상한가/하한가에 근접할 때 자동 매수/매도
// - Hot path: Stock에 바인딩되어 B6/A3 수신 시 즉시 평가
table SetLimitChaser {
    // === 기본 정보 ===
    isin: string;             // ISIN 코드 (12자리, 예: "KR7005930003")
    account_no: string;       // 계좌번호 (최대 12자리)
    market: string;           // 시장구분 ("K"=KOSPI, "Q"=KOSDAQ)
    // ★ Phase 11 슬롯(client_key) 제거 — 필드를 **지우지 않고** (deprecated) 로 봉인한다.
    //   FlatBuffers 는 테이블 필드 id 를 **선언 순서로** 부여하므로 가운데 필드를 지우면
    //   뒤 필드의 슬롯이 전부 한 칸씩 밀린다. 그러면 아직 갱신되지 않은 클라이언트가 보낸
    //   메시지를 서버가 엉뚱한 필드로 읽는다 — 실계좌에서 그대로 오주문이다.
    //   deprecated 필드는 접근자가 생성되지 않으므로 코드에서는 이미 사라진 것과 같다.
    client_key: ubyte (deprecated);   // (봉인) 구 클라이언트 키 — 슬롯 개념 폐기.
                              // 전략 키는 ISIN:accountNo:exchange 다 (D-01/D-02)
    crud: string;             // 동작 ("C"=생성/수정, "D"=삭제)

    // === 매수 조건 ===
    // 호가(B6) 기반 매수 조건:
    //   선매수(종전 매도호가 비교 갈래):
    //     - ask1Price == buyWatchPrice && ask1Qty <= buyWatchQty → 주문
    //     - bid1Price == buyWatchPrice → 주문 (매수호가가 감시가에 도달)
    //     - ask1Price > buyWatchPrice → 주문 (가격 상승)
    //   Phase 24: 매수 3종(선매수 = 종전 side '0' 갈래 / 추가매수 / 후매수) — docs/strategy/limit-chaser.md §5
    buy_order_price: uint;       // 매수 주문가격 (원, 보통 상한가)
    buy_order_qty: uint;         // 매수 주문수량 (주)
    buy_watch_price: uint;       // 매수 감시가격 (원, 보통 상한가)
    buy_watch_qty: uint;         // 매수 감시수량 (주, 최우선 호가 잔량과 비교)
    buy_min_trade_qty: uint;     // 최소 체결수량 (주, 이 값 이상 체결 시 주문)
    buy_watch_side: string (deprecated);   // (봉인) 구 호가비교 위치("0" 매도잔량 / "1" 매수잔량) — Phase 24 D-24/D-28 ③,
                                 // quick-260930-1s8 로 슬롯 24 봉인. 서버는 읽지 않는다(구 클라 매수 ON 은 값과 무관하게 거부)
    buy_trade_qty_enabled: bool; // 체결수량 조건 활성화
    buy_enabled: bool;           // 매수 감시 활성화 — Phase 24 부터 세 매수의 마스터(D-01). 에코는 cfg ∧ 마스터 무장: 그룹 하나의 발주로는 접히지 않고, 선·추가·후매수가 모두 접히면(발주·포기·소진) 서버가 내려 OFF 로 온다(D-34)

    // === 매도 조건 ===
    // 호가(B6) 기반 매도 조건:
    //   - bid1Price == sellWatchPrice && bid1Qty <= sellWatchQty → 주문
    //   - bid1Price < sellWatchPrice → 주문 (가격 하락)
    sell_order_price: uint;       // 매도 주문가격 (원)
    sell_order_qty: uint;         // **서버 계산값** (Set 시점 잔고×비율 스냅샷, 발주 시점 재계산)
                                  // — 클라 입력이 아니다. 요청값은 서버가 읽지 않는다 (D-16)
    sell_watch_price: uint;       // 매도 감시가격 (원)
    sell_watch_qty: uint;         // 매도 감시수량 (주)
    sell_min_trade_qty: uint;     // 최소 체결수량 (주, 이 값 이상 체결 시 주문)
    sell_min_cum_volume: uint (deprecated);     // (봉인) 구 최소 누적거래량 — 조건 폐기 (D-13)
    sell_enabled: bool;           // 매도 감시 활성화
    sell_trade_qty_enabled: bool; // 체결수량 조건 활성화
    sell_cum_volume_enabled: bool (deprecated); // (봉인) 구 누적거래량 조건 — 조건 폐기 (D-13)

    // === 한방 조건 (Case 2: 「한방 N건 @가격」 — 버스트가 쓸고 간 호가 칸 수 기반) ===
    // - 버스트 체결 = A3 매도1·매수1호가가 둘 다 0 으로 이어진 조각들(큰 주문 하나의 분할 체결).
    //   마지막 조각은 호가가 실려 오며, 직전 A3 가 0/0 매수 조각이면 그 마지막 조각도 센다 (quick-261003-phd).
    // - 체결가 == sweepWatchPrice이고, 쓸고 간 호가 칸 수가 sweepMinTickCount 이상이면 주문
    sweep_watch_price: uint;      // 한방 감시가격 (원, 클라 기본 = 상한가)
    sweep_enabled: bool;          // 한방 조건 활성화 (Case 2/3 공통)
    sweep_min_tick_count: ubyte;  // Case 2: 최소 한방 건수(호가 칸 수)
    sweep_recalc_enabled: bool;   // 체결 후 호가잔량 차감 재평가

    // === 한방 조건 (Case 3: 버스트 횟수 + 상승률 기반) ===
    // - 연속 버스트 조각(0/0 매수체결) 횟수가 sweepMinCount 이상이고, 상승률이 sweepMinRate 이상이면 주문
    sweep_min_count: ubyte;       // Case 3: 최소 버스트 횟수 (0=비활성)
    sweep_min_rate: uint;         // Case 3: 최소 상승률 (BasisPoints, 예: 2950=29.5%)

    exchange: string;             // 거래소 — **서버가 읽는다**. "KRX" / "NXT" 화이트리스트.
                                  // "NXT" 는 종목마스터 nxtTradable 인 종목만 등록된다 (D-04) —
                                  // 아니면 ERROR ServerMessage 로 거부한다 (조용한 미동작 금지).
                                  // 빈 값(구 클라)은 "KRX" 로 정규화 (D-26)

    // === 이하 Phase 6 추가 (테이블 **말미 append** — 기존 필드 순서 불변, 하위호환) ===
    // FlatBuffers 는 선언 순서로 field id 를 매긴다. 가운데 삽입/삭제는 wire 를 깨서
    // 미업그레이드 클라이언트가 엉뚱한 필드를 읽는다. 신규 필드는 반드시 여기 아래에만 붙인다.

    // A3Buy4 조건 (2026.04.16 gotrader v2.26.1/2.28 — 상한가 안착 시점 포착)
    // - A3(체결) 패킷 자체의 매수1호가가 상한가와 같으면 매수 주문
    // - 한방 체크(`sweep_enabled`) 종속 — 원전 `cond.BidSumTradeCheck`
    //
    // ★ Phase 11 의 전용 게이트(D-09)를 철회하면서도 필드를 **지우지 않고**
    //   (deprecated) 로 봉인한다. FlatBuffers 는 테이블 필드 id 를 **선언 순서로**
    //   부여하므로 가운데 필드를 지우면 뒤 필드의 슬롯이 전부 한 칸씩 밀린다.
    //   그러면 아직 갱신되지 않은 클라이언트가 보낸 메시지를 서버가 엉뚱한 필드로
    //   읽는다 — 실계좌에서 그대로 오주문이다.
    //   철회 사유: go-trader v2.37 (6a3f3c0) 원전에 게이트 플래그 없음 — D-09/D-17 철회 2026-08-30
    a3_buy4_enabled: bool (deprecated);  // (봉인) 구 A3Buy4 전용 게이트 — sweep_enabled 종속으로 환원

    // SmartSell (gotrader v2.32.1 — 원매수수량 잔량까지 동시 청산)
    // - 매도 발동 1회에 [sell_order_qty + (origin_ord_qty - sell_order_qty)] 2건을
    //   같은 sell_order_price 로 발주한다. 추가분이 0 이하면 기본 1건만 나간다
    // - gotrader 원문 필드명은 오타(OrginOrdQty) — 여기서는 origin_ord_qty 로 바로잡았다
    smart_sell: bool (deprecated);      // (봉인) 구 스마트매도 — 기능 폐기 (D-13)
    origin_ord_qty: uint (deprecated);  // (봉인) 구 원주문수량 — 기능 폐기 (D-13)

    // === 이하 Phase 11 추가 (테이블 **말미 append** — 기존 필드 순서 불변, 하위호환) ===
    // FlatBuffers 는 선언 순서로 field id 를 매긴다. 가운데 삽입/삭제는 wire 를 깨서
    // 미업그레이드 클라이언트가 엉뚱한 필드를 읽는다. 신규 필드는 반드시 여기 아래에만 붙인다.

    // 가격 돌파/이탈 게이트 (D-17) — **철회 2026-08-30**. 가격 항은 이제 설정과 무관하게
    // 항상 평가된다.
    //
    // ★ 필드를 **지우지 않고** (deprecated) 로 봉인한다. FlatBuffers 는 테이블 필드 id 를
    //   **선언 순서로** 부여하므로 가운데 필드를 지우면 뒤 필드(sell_order_ratio 이하)의
    //   슬롯이 전부 밀린다. 그러면 아직 갱신되지 않은 클라이언트가 보낸 메시지를 서버가
    //   엉뚱한 필드로 읽는다 — 실계좌에서 그대로 오주문이다.
    //   철회 사유: go-trader v2.37 (6a3f3c0) 원전에 게이트 플래그 없음 — D-09/D-17 철회 2026-08-30
    buy_price_break_enabled: bool = true (deprecated);   // (봉인) 구 매수 가격돌파 게이트 (B6Buy2/4/5)
    sell_price_break_enabled: bool = true (deprecated);  // (봉인) 구 매도 가격이탈 게이트 (B6Sell2)

    // 매도 수량 (D-16/D-18)
    sell_order_ratio: ubyte;      // 매도비율 % (1~100). 서버가 발주 시 sellableQty×ratio/100
                                  // 으로 매도수량을 계산한다 — 수량을 클라가 정하지 않는다
    sell_qty_track_enabled: bool; // 잔량추적(래칫) 활성화. 판정식은 docs/strategy/limit-chaser.md §6-3
    sell_qty_track_ratio: ubyte;  // 잔량추적(래칫) 비율 % (1~90)
    sell_qty_track_baseline: uint; // **S→C 전용** 현재 기준선 (주). 요청값은 서버가 읽지 않는다

    // === 이하 Phase 12 추가 (테이블 **말미 append** — 기존 필드 순서 불변, 하위호환) ===
    // FlatBuffers 는 선언 순서로 field id 를 매긴다. 가운데 삽입/삭제는 wire 를 깨서
    // 미업그레이드 클라이언트가 엉뚱한 필드를 읽는다. 신규 필드는 반드시 여기 아래에만 붙인다.

    // 매수 주문금액 (만원) — 클라이언트의 **의도값**이다 (debug: limitchaser-buy-value-drift).
    // 서버는 이 값을 조건 평가에도 발주에도 쓰지 않는다. 보관했다가 에코·조회 응답에 그대로
    // 되돌려 줄 뿐이다 — 발주 정본은 어디까지나 buy_order_qty(주)다.
    //
    // 왜 필요한가: 금액 칸은 클라 전용 입력이라 서버 왕복으로 복원될 경로가 없었다. 창을 다시
    // 열면 폼은 Designer 기본값(20,000만원)을 보여 주는데 서버 진실은 2주(66.8만원)일 수
    // 있었고, 그 상태에서 다른 칸 하나만 고치면 자동 재제출이 기본값으로 수량을 재계산해
    // 무장 수량이 조용히 약 300배가 됐다.
    //
    // 왜 역산(수량×가격÷10000)이 아닌가: 나눗셈의 나머지가 버려져 왕복이 깨진다 —
    // 가격 1,000·수량 5 는 역산하면 1만원이 되고, 그 1만원으로 재제출하면 10주가 된다 (11 D-15).
    //
    // 0 = "서버가 모른다"(구 클라가 보냈거나 아직 한 번도 실린 적 없음). 클라는 0 이면
    // 금액 칸을 건드리지 않는다.
    buy_order_amount: uint;

    // === 이하 quick-260902-nl8 추가 (테이블 **말미 append** — 기존 필드 순서 불변, 하위호환) ===
    // FlatBuffers 는 선언 순서로 field id 를 매긴다. 가운데 삽입/삭제는 wire 를 깨서
    // 미업그레이드 클라이언트가 엉뚱한 필드를 읽는다. 신규 필드는 반드시 여기 아래에만 붙인다.

    // 매도 진입 확인 래치 — **S→C 전용** 표시값이다 (요청값은 서버가 읽지 않는다).
    // - false = 잠복: 비교가격에 매수 지지벽이 쌓인 것을 아직 한 번도 관측하지 못했다.
    //           매도 판정(잔량 항·이탈 항·A3 항)을 아예 하지 않는다.
    // - true  = 관측 완료: 그 시점부터 매도 판정이 돈다.
    // 판정식·리셋 규칙(재제출/비활성화가 푼다)은 docs/strategy/limit-chaser.md §6-3.
    //
    // ★ 값은 `sell_enabled` 와 달리 무장(armed)과 접지 않은 **원값**이다
    //   (LimitChaser::IsSellEntryLatched()). 접으면 "매도 OFF 인데 래치는 살아 있음" 이라는
    //   서버 진실이 사라진다 — 무장과 래치는 직교하는 두 상태이고, 무엇을 보여줄지는 클라가 정한다.
    sell_entry_latched: bool;

    // === 이하 quick-260904-rb7 추가 (테이블 **말미 append** — 기존 필드 순서 불변, 하위호환) ===
    // FlatBuffers 는 선언 순서로 field id 를 매긴다. 가운데 삽입/삭제는 wire 를 깨서
    // 미업그레이드 클라이언트가 엉뚱한 필드를 읽는다. 신규 필드는 반드시 여기 아래에만 붙인다.
    //
    // 매수 미체결 자동취소 — 내 상따 매수 주문이 미체결(잔량>0)인 동안 "상한가가 무너질 조짐"
    // 이 보이면 서버가 그 주문의 **미체결 잔량만** 취소한다 (판정식 docs/strategy/limit-chaser.md §6-5).
    // - 취소 판정의 비교가격은 buy_order_price 이고 별도 가격 필드는 없다 — 내 주문이 그 가격에
    //   살아 있는 한 매수1호가가 아래로 갈 수 없다(내 주문 자체가 매수1호가를 받친다).
    // - 체결 임계·추적 비율은 매도 옵션(sell_min_trade_qty / sell_qty_track_ratio)을 재사용한다.
    // - 셋 중 하나라도 true 면 취소 감시 활성 — 별도 ON 플래그 없음(체크박스 = 활성).
    //   에코의 세 플래그는 매수·매도 enabled 처럼 무장(armed)과 접힌 값이다 — 취소가 한 번 나가면 OFF.
    // - 구 클라(4필드 미전송)는 전부 false/0 으로 읽혀 동작이 종전과 같다.
    cancel_qty_enabled: bool;        // ☐취소:잔량 — B6 잔량항 게이트 (매수주문가==매수1호가 ∧ 매수1잔량 <= 취소잔량)
    cancel_watch_qty: uint;          // 취소 감시 잔량(주). 잔량추적 ON 이면 기준선의 바닥(초기값)
    cancel_trade_enabled: bool;      // ☐체결 — A3 매도체결 항, 임계는 sell_min_trade_qty 재사용
    cancel_qty_track_enabled: bool;  // ☐잔량추적 — 비율은 sell_qty_track_ratio 재사용, 기준선 초기값 = cancel_watch_qty

    // === 이하 quick-260907-eu4 추가 (테이블 **말미 append** — 기존 필드 순서 불변, 하위호환) ===
    // FlatBuffers 는 선언 순서로 field id 를 매긴다. 가운데 삽입/삭제는 wire 를 깨서
    // 미업그레이드 클라이언트가 엉뚱한 필드를 읽는다. 신규 필드는 반드시 여기 아래에만 붙인다.

    cancel_qty_track_baseline: uint; // **S→C 전용** 현재 취소 기준선 (주). 요청값은 서버가 읽지 않는다

    // === 이하 quick-260910-kel 추가 (테이블 **말미 append** — 기존 필드 순서 불변, 하위호환) ===
    // FlatBuffers 는 선언 순서로 field id 를 매긴다. 가운데 삽입/삭제는 wire 를 깨서
    // 미업그레이드 클라이언트가 엉뚱한 필드를 읽는다. 신규 필드는 반드시 여기 아래에만 붙인다.

    // 취소 진입 확인 래치 — **S→C 전용** 표시값이다 (요청값은 서버가 읽지 않는다, D-02).
    // - false = 잠복: 매수1호가에 지지벽이 임계 위로 쌓인 것을 아직 한 번도 관측하지 못했다.
    //           취소 판정(잔량 항·체결 항)을 아예 하지 않는다.
    // - true  = 관측 완료: 그 시점부터 취소 판정이 돈다.
    // 판정식·리셋 규칙(브로커 'A' 접수·재제출·비활성화가 푼다)은 docs/strategy/limit-chaser.md §6-5.
    //
    // ★ 값은 취소 3플래그(cancel_qty_enabled 등)와 달리 무장(armed)과 접지 않은 **원값**이다
    //   (LimitChaser::IsCancelEntryLatched()). sell_entry_latched 의 규약과 글자 그대로 같다 —
    //   접으면 "취소 무장 OFF 인데 래치는 살아 있음" 이라는 서버 진실이 화면에서 소멸한다.
    //   구 클라는 이 필드가 없어 false(잠복)로 읽고, 그것이 안전한 방향이다.
    cancel_entry_latched: bool;

    // === 이하 quick-260910-ttc 추가 (테이블 **말미 append** — 기존 필드 순서 불변, 하위호환) ===
    // FlatBuffers 는 선언 순서로 field id 를 매긴다. 가운데 삽입/삭제는 wire 를 깨서
    // 미업그레이드 클라이언트가 엉뚱한 필드를 읽는다. 신규 필드는 반드시 여기 아래에만 붙인다.

    // (봉인) 매수 진입 확인 래치 — Phase 24 D-25 로 서버 기계(관측·수동 점등 38·영속)가 삭제됐다.
    //        값·배선 없음. 필드 id 는 선언 순서라 지우지 않고 (deprecated) 로 슬롯 96 을 보존한다.
    //        구 클라는 부재를 false(잠복)로 읽는다 — 안전한 방향이다.
    buy_entry_latched: bool (deprecated);   // (봉인) 구 매수 진입 확인 래치 — Phase 24 D-25 로 기계 삭제, 슬롯 96 유지

    // === 이하 Phase 24 추가 (테이블 **말미 append** — 기존 필드 순서 불변, 하위호환, D-17) ===
    // FlatBuffers 는 선언 순서로 field id 를 매긴다. 가운데 삽입/삭제는 wire 를 깨서
    // 미업그레이드 클라이언트가 엉뚱한 필드를 읽는다. 신규 필드는 반드시 여기 아래에만 붙인다.
    //
    // 매수 3종 분리 — 선매수·추가매수·후매수 (docs/strategy/limit-chaser.md §5).
    // - buy_enabled 는 세 매수의 **마스터**다(D-01). buy_watch_price·buy_order_price 는 세 매수 공통(D-20).
    // - 기존 buy_order_qty·buy_order_amount·buy_watch_qty·buy_trade_qty_enabled·buy_min_trade_qty·
    //   sweep_* 는 **선매수의 값**으로 재해석한다(D-17).
    // - 구/신 클라 판별은 buy3_schema 의 부재(0) 하나다(D-24).
    buy3_schema: ubyte;              // 0 = 구 클라(필드 부재) → 매수 ON 은 고정 문구 ERROR 로 거부하고 매수 3종을 켜지 않는다(D-28 · quick-260930-1s8).
                                     // 1 = 3종 클라 · 2 = post_buy_auto 를 싣는 클라(quick-260929-ucy — 서버는 2 이상일 때만
                                     // post_buy_auto 를 읽는다) · 3 = extra_buy_burst_release 를 싣는 클라(quick-261003-phd 후속 —
                                     // 서버는 3 이상일 때만 읽는다). 서버 에코는 1 그대로 (D-24 판정 정본). vtable 98
                                     // 4 = 자동매도 4필드를 싣는 클라(Phase 28 D-18) — 서버는 >= 4 일 때만 읽는다
    pre_buy_enabled: bool;           // 선매수 체크 (양방향) — 에코는 무장과 접힌다(D-03). vtable 100
    // ★ 아래 6필드의 와이어 이름은 extra_buy_* 다 (Phase 24 D-29 — C# 생성물의 buy_* 빌더 메서드와 이름 충돌
    //   회피로 add_→extra_). 선언 위치·형·순서·vtable 슬롯(102~112)은 그대로라 와이어 바이트가 같다.
    //   서버 내부 식별자(addBuy*)·상태 파일 키(add_buy_*)·OrderReason::AddBuy* 는 그대로다.
    extra_buy_enabled: bool;           // 추가매수 체크 (양방향) — 에코는 cfg && 무장 && !포기 (D-03/D-08). vtable 102
    extra_buy_min_qty: uint;           // 추가매수 최소 매수잔량(주, C→S). 0 = 1주 (D-08) · 클라 기본값 = 상장주식수 × 0.3% 내림 (D-33). vtable 104
    extra_buy_max_qty: uint;           // 추가매수 최대 매수잔량(주, C→S). 0 = 무제한 (D-08) · 클라 기본값 = 상장주식수 × 3% 내림 (D-33). vtable 106
    extra_buy_order_amount: uint;      // 추가매수 주문금액(만원) — buy_order_amount 규약(보관·에코만). vtable 108
    extra_buy_order_qty: uint;         // 추가매수 주문수량(주, C→S) — 발주 정본. vtable 110
    extra_buy_abandoned: bool;         // **S→C 전용** 추가매수 포기 — 최대 초과(D-08)·상한가 이탈 최소 미달(D-33) 둘 다 이 한 bool, 어느 쪽인지는 INFO 사유 줄. 요청값은 서버가 읽지 않는다. vtable 112
    post_buy_enabled: bool;          // 후매수 체크(양방향) — 에코는 cfg ∧ 마스터 무장 ∧ 단계 ≠ 소진: 마스터 OFF 면 OFF(D-32, 선·추가매수와 같은 모양), 「소진」이면 OFF 로 접는다(D-31). 자기 게이트와는 접지 않는다 — 무장 여부는 post_buy_phase. vtable 114
    post_buy_rebound_pct: ubyte;     // 후매수 반등률 % (C→S, 1~100). vtable 116
    post_buy_floor_qty: uint;        // 후매수 하한잔량(주, C→S). vtable 118
    post_buy_reentry: ubyte;         // 후매수 최대 횟수(최초 포함, D-30) — C→S 「최대」 칸. OFF→ON 재무장은 잔여를 이 값으로 다시 싣는다(D-31). vtable 120
    post_buy_order_amount: uint;     // 후매수 주문금액(만원) — buy_order_amount 규약(보관·에코만). vtable 122
    post_buy_order_qty: uint;        // 후매수 주문수량(주, C→S) — 발주 정본. vtable 124
    post_buy_trigger_qty: uint;      // **S→C 전용** 발동잔량(주). 요청값은 서버가 읽지 않는다. vtable 126
    post_buy_reentry_left: ubyte;    // **S→C 전용** 재진입 잔여(회). 요청값은 서버가 읽지 않는다. vtable 128
    post_buy_phase: ubyte;           // **S→C 전용** 0 꺼짐 / 1 감시 / 2 보유중 / 3 소진. 요청값은 서버가 읽지 않는다. vtable 130
    // === 이하 quick-260929-ucy 추가 (말미 append) ===
    post_buy_auto: bool;             // ☐자동(양방향) — ON 이면 선매수·추가매수가 상따 취소 옵션으로 무체결 전량취소되거나 보유 0 전이 때 서버가 후매수를 1회 켜고
                                     // 이 값을 false 로 에코한다(꺼져 있던 마스터도 올린다 — docs/strategy/limit-chaser.md §5-3-1).
                                     // 서버는 buy3_schema >= 2 일 때만 읽는다(1 이하는 서버 값 유지 — 구 클라·gh-radar relay).
                                     // 에코는 서버 런타임 값. vtable 132
    // === 이하 quick-260930-e5o 추가 (말미 append) ===
    extra_buy_abandon_qty: uint;     // **S→C 전용** 추가매수 포기가 성립한 틱의 매수1잔량(주) — 포기 아님 = 0. 클라 상태 줄
                                     // 「추가매수 포기(최대 초과 N — …)」 의 N. 재기동에도 유지된다(상태 파일 add_buy_abandon_qty).
                                     // 요청값은 서버가 읽지 않는다. vtable 134
    // === 이하 quick-261002-dra 추가 (말미 append) ===
    post_buy_unlock_qty: uint;       // **S→C 전용** 후매수 잠금 해제선(주) — 잠금 중(☐후매수 유효 · 단계 감시 · 해제 전 · peak > 0)이면
                                     // floor(peak × (100 − 반등률) / 100), 그 밖 0. 매수1잔량이 이 값 이하가 되면 잠금이 풀린다.
                                     // 클라 「발동」 칸 회색 표시. post_buy_trigger_qty 의 의미는 그대로(잠금 중 0).
                                     // 요청값은 서버가 읽지 않는다. vtable 136
    // === 이하 quick-261003-phd 추가 (말미 append) ===
    extra_buy_burst_release: bool;   // 추가매수 ☐버스트 시 해제(양방향, 와이어 이름 extra_buy_* 규약 D-29) — ON 이면 버스트 상한가가
                                     // 판정된 뒤 처음 만나는 B6 틱에 켜져 있던 추가매수를 서버가 내린다(포기 아님 — extra_buy_abandoned
                                     // 무접촉, 사용자가 다시 켤 수 있다). 판정당 1회. 서버는 buy3_schema >= 3 일 때만 읽는다 — 그 미만
                                     // (C# 구 클라 · 웹 lc.set 재제출을 중계하는 gh-radar relay)은 서버 값 유지(2026-10-03 gh-radar 합의,
                                     // post_buy_auto 와 같은 규약). 에코는 설정값. vtable 138
    // === 이하 Phase 28 추가 (자동매도 — 말미 append, 28-CONTEXT D-18 · 28-HANDOFF §1) ===
    // 요청 4필드(140~146)는 buy3_schema >= 4 일 때만 서버가 읽는다 — 그 미만(C# 구 클라 · 옛 relay)은 서버 값 유지.
    // S→C 전용 4필드(148~154)는 요청값을 서버가 읽지 않는다(relay 서버전용 필드 목록 대상 — HANDOFF §1).
    auto_sell_enabled: bool;         // ☐자동매도 (양방향). vtable 140
    auto_sell_start_cond: ubyte;     // 시작조건 0~9 (양방향) — 0 = 기준가격 이탈 관측 뒤 다음 체결 · N = 기준가격 − 거래소 기준가×N% (호가단위 내림) 이하 체결. vtable 142
    auto_sell_ratio_pct: ubyte;      // 비율 % 1~50 (양방향) — 주기 거래량 × 비율 (올림). vtable 144
    auto_sell_method: ubyte;         // 매도 방법 (양방향) — 1 매도1호가 · 2 매수1호가 · 3 절반절반. vtable 146
    auto_sell_state: ubyte;          // **S→C 전용** 0 없음 · 1 대기 · 2 감시 · 3 매도중 · 4 완료 (StrategyEvent kind 13 과 같은 값). vtable 148
    auto_sell_sold_qty: uint;        // **S→C 전용** 누적 매도수량(주). vtable 150
    auto_sell_basis: ubyte;          // **S→C 전용** 기준 종류 1 상한가 · 2 매수가 (0 미정). vtable 152
    auto_sell_basis_price: uint;     // **S→C 전용** 기준가격(원 — 상한가 또는 매수가). vtable 154
}

// VITrigger (VI 발동) 전략 설정
// - R8(VI발동) 이벤트 수신 시 상승률 체크 후 자동 매수
// - 전 종목 대상, Stock 바인딩 없음
// - 거래소별 1건 — R8 을 받은 fd 의 거래소 슬롯만 발주한다 (Phase 21 D-01/D-08)
table SetVITrigger {
    account_no: string;       // 계좌번호 (최대 12자리)
    order_amount_krw: ulong;  // 주문금액 (원, 주문가격으로 나눠 수량 계산)
    check_rate: int;          // 상승률 조건 (정수 %, 예: 25=25% 이상일 때 주문)
    price_type: string;       // 주문가격 유형 ("U"=상한가, "L"=하한가)
    run: bool;                // 전략 활성화

    // === 이하 Phase 21 추가 (테이블 **말미 append** — 가운데 삽입 금지, 하위호환) ===
    exchange: string;         // 거래소 "KRX" / "NXT" (Phase 21 D-03 말미 append).
                              // ★ **빈 값·미지정 = KRX** — 구 클라·구 strategy_state.toml 이
                              //   마이그레이션 없이 그대로 KRX 설정으로 읽힌다.
                              // VI 전략은 세션당 거래소별 1건(KRX 1 + NXT 1)이고 Set/Get/에코가
                              // 전부 거래소별이다 (D-01). vtable 슬롯 14
}

// VI 자동주문 발주 통지 (Server -> Client 푸시, Phase 11.1 D-14)
// - Server::OnVI 가 발주에 **성공**한 주문마다 그 세션의 모든 연결에 보낸다 (발주 세션에만 —
//   타 사용자로 새지 않는다). 실패·접수 불명(ORDER_SEND_UNCERTAIN)에는 보내지 않는다.
// - 값은 전부 발주 시점 서버가 아는 것(종목마스터·R8)이며, 주문번호는 아직 없다 —
//   뒤따르는 OrderResp(origin="VITrigger", notice_type="A") 가 주문번호를 준다.
// - 클라는 이 통지로 주문내역 그리드 행(발동가·전일대비·주문가격·주문수량)을 만들고
//   자동취소 110초 데드라인의 발동 시각으로 삼는다 (CP-2)
table VIOrderNotice {
    isin: string;          // 발동 종목 ISIN (12자)
    account_no: string;    // 발주 계좌
    trigger_price: uint;   // VI 발동가 (R8)
    base_price: uint;      // 마스터 기준가 — 클라가 전일대비 % 를 소수 2자리로 계산한다
    change_rate: int;      // 서버 판정에 쓴 상승률 (정수 %, CalcIncreaseRate 내림)
    order_price: uint;     // 주문가 (= 상한가, price_type "U")
    order_qty: uint;       // 주문수량 (상한수량 클램프 후)
    market: string;        // "K"/"Q" — R8 정보구분. 클라 취소 DirectOrderReq 의 market 원천
    order_seq: ubyte;      // 발동당 주문 순번 — CP-1(cp1-g) 로 항상 1, 장래 확장 슬롯
    vi_end_time: string;   // R8 timeEndingVI 9자 "HHMMSSuuu" — 참고용 (110초 규칙은 클라 상수)

    // === 이하 Phase 21 추가 (테이블 **말미 append** — 가운데 삽입 금지, 하위호환) ===
    exchange: string;      // 발주 거래소 "KRX" / "NXT" (Phase 21 D-10). 클라 주문내역 '거래소'
                           // 열과 수동 취소 DirectOrderReq.exchange 의 원천이다. 빈 값 = KRX.
                           // vtable 슬롯 24
}

// 상따 전략 전수 열거 응답 (Server -> Client, Phase 12 D-02)
// - 원소는 Set 에코(SetLimitChaserResp)와 **같은 바이트**다. 서버는 에코·열거·11.2 푸시를
//   전부 `Gateway::AddLimitChaserTable` 하나로 만든다 — 두 벌이면 새 설정 필드가 한쪽에만
//   붙어서 "조회하면 보이는데 목록에는 없는 값" 이 생긴다 (Phase 6 선례).
// - 전략이 0건이거나 StrategyManager 가 아직 없어도 **길이 0 벡터를 실은 응답**을 보낸다
//   (무응답 금지 — 11 D-09 동형). 클라는 items 길이만 보면 된다.
table LimitChaserList {
    items: [SetLimitChaser];
}

// 전략 비활성화 요청 (Client -> Server, Phase 12 D-12)
// - key == "" 이면 그 세션의 상따 **전부** + VI 를 내린다 (킬 스위치).
// - key 가 비어 있지 않으면 `ISIN:계좌:거래소` 그 한 건만 내린다.
// - 어느 쪽이든 **등록은 유지**하고 발주 게이트만 내린다 — 삭제(crud='D')가 아니다.
table DisableStrategiesReq {
    key: string;
}

// 전략 비활성화 집계 응답 (Server -> Client, Phase 12 D-12)
// - 서버는 키별 SetLimitChaserResp / SetVITriggerResp 에코를 같은 user 의 모든 연결에
//   보낸 **뒤** 이 집계를 요청 연결에만 보낸다 — 클라가 이 응답을 받은 시점에는 이미
//   모든 행이 OFF 로 갱신돼 있다 (같은 연결 큐라 순서가 보장된다).
table DisableStrategiesResp {
    disabled_count: uint;   // 내린 상따 전략 수
    vi_disabled: bool;      // VI 를 내렸으면 true
}

// 시간외/시간외단일가 전략 설정 테이블 2종은 Phase 6 에서 삭제됐다 (전략 사용 종료).
// MsgType 12/13/22/23/62/63 과 Envelope 슬롯은 재사용 금지로 예약돼 있다.

// 전략 조회 요청
table GetStrategyReq {
    key: string;              // 전략 키 (ISIN:accountNo:exchange) — 슬롯 제거 (D-01)
                              // ★ GetVITriggerReq(21) 에서는 거래소 문자열("KRX"/"NXT")이고
                              //   빈 값 = KRX 다 — 새 필드 없이 슬롯을 재사용한다
                              //   (Phase 21 D-03, MsgType 35~38 의 요청 슬롯 재사용 선례 동형 —
                              //    스키마·vtable 은 바뀌지 않는다)
}

// ============================================================================
// Phase 13: 계좌 상태 공유 (D-01~D-14)
//
// 서버 AccountManager 가 계산·영속화하는 잔고·미체결을 클라이언트가 실시간으로 본다.
// 스냅샷 조회(25/66) + 증분 델타 푸시(67) + 원장 기준 대사(26/68).
// 클라는 재계산하지 않는다 — 화면 = 서버 진실 (D-01).
// ============================================================================

// 잔고 1종목 (AccountManager::StockHolding 사상)
table HoldingState {
    isin: string;          // 12자 ISIN
    stock_qty: uint;       // 보유수량
    sellable_qty: uint;    // 매도가능수량
    avg_price: double;     // 평단가 — 서버가 double 로 들고 있다 (uint 내림 금지)
}

// 미체결 1건 (AccountManager::PlacedOrder 사상)
table UnfilledState {
    order_no: string;      // 주문번호 (미체결 맵 키)
    org_order_no: string;  // 원주문번호 (정정·취소 승계)
    isin: string;          // 12자 ISIN
    side: string;          // "B"/"S"
    price: uint;           // 주문가
    order_qty: uint;       // 주문수량
    filled_qty: uint;      // 체결수량
    unfilled_qty: uint;    // 미체결수량

    // === 이하 Phase 16 추가 (테이블 **말미 append** — 기존 필드 순서 불변, 하위호환) ===
    // FlatBuffers 는 선언 순서로 field id 를 매긴다. 가운데 삽입/삭제는 wire 를 깨서
    // 미업그레이드 클라이언트가 엉뚱한 필드를 읽는다. 신규 필드는 반드시 여기 아래에만 붙인다.

    exchange: string;      // 거래소 "KRX" / "NXT" — 미체결 그리드의 거래소 열 (D-12).
                           // **미지정(구 서버·구 상태파일)은 "KRX" 로 정규화한다.**
                           // 잔고(HoldingState)에는 넣지 않는다 — 잔고는 종목 단위이고
                           // NXT 로 산 주식을 KRX 에서 팔 수 있다 (D-09)

    // === 이하 quick-260907-g7b 추가 (테이블 **말미 append** — 기존 필드 순서 불변) ===

    order_time: string;    // 주문시각 "HHMMSSmmm"(9자리) — 미체결 그리드 '시간' 열의 유일한 원천.
                           //
                           // ★ **거래소 접수시각**이다 (quick-261001-euc) — KB TTRODP113 ·
                           //   교보 Order Receive Time 의 ordAcceptTime. broker::ExecutionReport
                           //   (order.bin 호환 148바이트 고정)에 싣지 않고 브로커 콜백 스코프의
                           //   thread_local 옆길(broker/ExecNoticeContext.h)로 원장에 넘긴다.
                           //   없으면(Mock·형식 불량) 서버가 통보를 반영한 벽시계 ms 다.
                           //
                           // ★ 6자리 "HHMMSS" 는 구 상태파일 복원분과 예약(Q) 행(createdAt)뿐이다.
                           //   클라는 9자리면 ms 까지, 6자리면 초까지 그린다.
                           //
                           // ★ **값이 없으면 빈 문자열이다. "000000" 으로 채우지 않는다.**
                           //   비는 자리는 정확히 둘이고 둘 다 서버가 접수를 못 본 주문이다:
                           //   ① order_time 키가 없는 구포맷 account_state.toml 복원분
                           //   ② 원장 대사로 주입된 주문 (OCX TA1006 에 시각이 없다)
                           //   클라는 공란을 공란으로 둔다 — 지어내면 화면에 거짓이 남는다.

    // === 이하 Phase 18.1 추가 (테이블 **말미 append** — 기존 필드 순서 불변, 하위호환) ===

    queued_status: string;   // 예약 상태 문구 (18.1 D-13).
                             //
                             // ★ **빈 문자열 = 일반 미체결 행이다.** 예약이 없는 날에는
                             //   66/67 의 모든 행이 이 값을 빈 문자열로 싣는다 — 구 클라는
                             //   슬롯을 읽지 않으므로 화면이 한 글자도 바뀌지 않는다.
                             //
                             // ★ 값이 있으면 이 행은 **예약 요약 행**이다 (order_no = Q-ID,
                             //   조각 N 개의 집계). 문구는 서버가 정하고 **클라는 판정하지
                             //   않고 표시만 한다** — 대기/발사중/완료/실패 같은 상태를
                             //   클라가 다시 계산하면 서버와 어긋난 화면이 생긴다 (13 D-01).

    // === 이하 Phase 18.2 추가 (테이블 **말미 append** — 기존 필드 순서 불변, 하위호환) ===

    pending_status: string;  // 접수대기 문구 (18.2 D-03/D-05) — KB FEP 가 개장 전까지 보관한 주문.
                             // ★ **빈 문자열 = 일반 행이다** (queued_status 와 같은 규약 — 구 클라는
                             //   슬롯을 읽지 않으므로 화면이 한 글자도 바뀌지 않는다).
                             // "증권사 보관 · 09:00 처리"(NXT 08:00) · "취소 보관 · 09:00 확정"(NXT 08:00) —
                             // 거래소 미상 행은 시각 없이 "… 개장 때 처리/확정" (quick-260915-bh1).
                             // 문구는 서버가 정하고 클라는 **표시만** 한다 — 판정은 아래 pending_cancel_sent.
    board: string;           // 주문 보드 — **"G2"/"G3" 만 싣는다. G1·G4·미상은 ""** (18.2 D-19).
                             // 시간외종가 행을 클라가 구분해 표시하는 원천이다.

    // === 이하 quick-260915-bh1 추가 (테이블 **말미 append** — 기존 필드 순서 불변, 하위호환) ===

    pending_cancel_sent: bool;  // 접수대기 행에 취소를 이미 보냈다(서버 원장 'X')면 true · 그 밖 false.
                                // 구 서버는 부재 = false 라 신 클라가 종전과 같이 동작한다.
                                // ★ 클라 회색 표시·취소 제외 판정의 **유일한 원천**이다 —
                                //   pending_status 문구로 판정하지 않는다 (tasks/lessons.md 교훈 24).
}

// 스냅샷·델타·대사 교정 팬아웃 공용 본문 (MsgType 66/67 이 같은 슬롯을 공유한다).
// 빌더 함수 1개를 공유한다 — 두 벌이면 새 필드가 한쪽에만 붙는다 (Phase 12 D-02 단일 빌더 관례).
//
// ★ is_snapshot=true  → holdings/unfilled 는 그 계좌의 **전량**. 클라는 전량 교체한다.
//   is_snapshot=false → **변경분만** 싣는다. 클라는 키(ISIN/주문번호)로 행을 upsert 하고,
//                       removed_order_nos 에 실린 주문번호 행을 제거한다 (D-02/D-10).
//   removed_order_nos 는 델타 전용 삭제 표식이다 (전량체결·취소·정정승계·장전 만료).
table AccountState {
    account_no: string;              // 계좌번호
    holdings: [HoldingState];        // 스냅샷=전량 / 델타=변경분만
    unfilled: [UnfilledState];       // 스냅샷=전량 / 델타=변경·신규분만
    removed_order_nos: [string];     // 델타 전용 삭제 표식 (스냅샷에서는 비운다)
    is_snapshot: bool;               // true=전량 교체, false=키 upsert + removed 행 제거
    server_time: string;             // 갱신시각 표시용
}

// 계좌 상태 스냅샷 조회 요청 (Client -> Server, D-05)
table GetAccountStateReq {
    account_no: string;    // 빈 값 = 세션 선언 계좌 전부 (계좌당 1 Resp 프레임)
}

// 원장 대사 업로드 (Client -> Server, D-13)
// - 클라가 OCX TR 로 읽은 **원장 스냅샷**이다. 서버는 자기 상태와 비교해 원장 값으로 교정한다.
table ReconcileAccountStateReq {
    account_no: string;
    holdings: [HoldingState];        // 원장(TA1001) 잔고 스냅샷 — avg_price 는 원장 매입평균가
    unfilled: [UnfilledState];       // 원장(TA1006 SecCode=3) 미체결 스냅샷
    retry: bool;                     // 클라 재시도분 표시 (서버 로그·재시도 종결 판정용)
}

// 원장 대사 결과 집계 (Server -> Client, D-13) — 요청 연결에만 보낸다.
table ReconcileAccountStateResp {
    account_no: string;
    result: string;                  // "OK"(일치) / "CORRECTED"(교정) / "RETRY"(보류—재조회 요청) / "SKIPPED"(가드 거부)
    holding_diffs: uint;             // 교정된 잔고 종목 수
    unfilled_diffs: uint;            // 교정된 미체결 건수 (추가+제거+수량변경)
    message: string;                 // 경고 로그 원문 (클라는 해석하지 않고 표기 — 10 D-03 관례)
}

// 예약 구간 상태 (Server -> Client, Phase 18.1 G5/G6) — MsgType QueuedWindowState(77)
// - 로그인 성공 직후 그 연결에 1프레임, 이후 open 이 바뀔 때마다(서버 1초 감시 틱) 로그인된
//   전 세션에 Notice 1프레임씩 보낸다. 빌더는 Gateway::BuildQueuedWindowStateEnvelope 한 벌.
// - **표시 전용 힌트다.** 클라는 이 값으로 예약매수/예약매도 라벨·조각 입력 활성·주문확인 예약 줄을
//   그린다. 주문이 예약인지는 주문이 도착한 시각에 서버(Gateway::ProcessDirectOrderReq)가 따로
//   판정한다 — 경계 전이는 1초 틱이라 1초까지 늦을 수 있다.
table QueuedWindowState {
    open: bool;          // [queued_order] enabled AND 서버 MarketClock::IsKrxQueueWindow (평일 [15:20,16:00) 또는 mock 창)
    max_pieces: uint;    // [queued_order] max_pieces — 클라 조각 수 입력 상한

    // === 이하 Phase 18.2 추가 (테이블 **말미 append** — 기존 필드 순서 불변, 하위호환) ===
    // 전부 표시 전용 힌트다 (18.1 G5/G6) — 서버 창 비트마스크(Gateway::ComputeWindowMask) 하나에서 나온다.

    preopen_open: bool;      // [preopen_order] enabled AND IsKrxPreOpenWindow — 라벨만 예약매수/예약매도,
                             // 조각 입력 없음 (18.2 D-11)
    g2_open: bool;           // KRX 장개시전 시간외종가 [08:30,08:40)
    g3_open: bool;           // KRX 장종료후 시간외종가 G3/AB1~G4/AB1 2단 (M4 미수신 폴백 [15:40,16:00))
    nxt_preopen_open: bool;  // [preopen_order] enabled AND NXT 평일 08:00 전
}

// ============================================================================
// Phase 15: 시세·종목정보 서버 원천화 (D-02~D-07 / D-12 / D-13)
//
// 클라이언트가 OCX 로 받던 시세·호가·체결 테이프·종목마스터를 DMA 서버가 KRX·NXT
// 양 거래소 기준으로 직접 공급한다. 조회(Get) 왕복과 구독(Subscribe) 푸시를 분리하고(D-07),
// 스냅샷/증분은 66/67 선례대로 **같은 본문 테이블 + is_snapshot** 으로 구분한다.
//
// ★ 아래 테이블과 Envelope 슬롯은 전부 **말미 append** 다. 기존 필드·deprecated 슬롯
//   (MsgType 12/13/22/23/62/63, Envelope 의 구 시간외 예약 슬롯 2종) 은 한 글자도 건드리지
//   않는다 — 가운데 삽입은 미갱신 클라이언트의 주문 필드를 밀어 실계좌 오주문이 된다.
//
// ★ 거래소(exchange)는 "KRX" / "NXT" 문자열이다. **서버가 화이트리스트로 검증**하고
//   그 외 값은 거부한다 (검증 구현은 15-10 Gateway 핸들러 — 이 파일은 스키마만이다).
// ============================================================================

// 시세 스냅샷 조회 요청 (Client -> Server, D-07)
// - 창 열림 순서는 Get(스냅샷) → Subscribe(증분) 다.
table GetQuoteReq {
    isin: string;             // 12자 ISIN
    exchange: string;         // "KRX" / "NXT"
}

// 종목 시세 구독/해제 요청 (Client -> Server, D-05)
// - 구독 집합은 세션 계좌 선언(`Session::m_accountList` 잎 락+스냅샷 규약)의 복사판으로
//   세션별로 관리한다. 구독 키는 종목+거래소다 (D-11).
// - **해제는 별도 MsgType 이 아니라 subscribe=false** 다. Un~ 메시지를 하나 더 두면
//   구독/해제 두 경로에 같은 키 정규화가 두 벌 생긴다 (Phase 12 D-02 단일 빌더 관례 동형).
// - 전략 미등록 종목도 구독할 수 있어야 한다 — 자동완성으로 임의 종목을 조회한다 (D-05).
// - level (quick-260923-exo, 테이블 말미 append — vtable 슬롯 10, 기존 4/6/8 불변):
//     0 = FULL  (종전 그대로 — 59 QuoteUpdate 를 어느 섹션이든 갱신된 틱마다 + 71 TradeTapePush + 75 MemberStatsPush)
//     1 = PRICE (가벼운 시세 — 59 만. 가격 섹션(A3 체결·R8 VI·A6 종가) 갱신 때만, 키당 최소 100ms(틱 1개) 간격.
//               호가(B6)만 바뀐 틱에는 보내지 않는다. 본문은 FULL 과 같은 빌더라 호가 벡터도 그대로 실린다)
//     그 밖 값은 0(FULL) 으로 취급한다 — 모르는 값을 더 가벼운 경로로 열화시키지 않는다.
//   · 같은 (연결·종목·거래소) 재구독은 level 을 **덮어쓴다** (서버 refcount 없음, 연결당 상한을 두 번 세지 않는다).
//   · subscribe=false 는 level 과 무관하게 그 키를 해제한다.
//   · PRICE→FULL 승격에 서버 스냅샷 전송은 없다 — 스냅샷이 필요한 소비자는 28(GetQuoteReq) 을 보낸다
//     (relay 도 0→1 구독과 같은 순서로).
//   · 기본값 0 이라 level 을 싣지 않는 옛 클라·relay 는 종전(FULL)과 같다.
table SubscribeQuoteReq {
    isin: string;
    exchange: string;
    subscribe: bool;          // true=구독, false=해제
    level: ubyte = 0;         // 0=FULL(종전) / 1=PRICE(59 만·가격 섹션 갱신 때만·100ms) — quick-260923-exo, 말미 append
}

// 체결 테이프 스냅샷 조회 요청 (Client -> Server, D-02)
table GetTradeTapeReq {
    isin: string;
    exchange: string;
    count: int;               // 요청 건수. 0 이하·링버퍼 보유분 초과는 서버가 보유분으로 클램프한다
}

// 시세 본문 — MsgType 58/59 가 Envelope 의 `quote_state` 슬롯 **하나를** 공유한다 (66/67 선례).
// 빌더 함수도 한 벌만 둔다 — 두 벌이면 새 필드가 한쪽에만 붙어서 "조회하면 보이는데 푸시에는
// 없는 값" 이 생긴다 (Phase 12 D-02 단일 빌더 관례).
//
// ★ is_snapshot=true  → GetQuoteResp(58). 창 열림 시 전량 초기화 (Notice — 요청 응답).
//   is_snapshot=false → QuoteUpdate(59). 100ms 코얼레싱 푸시 (Broadcast — 드롭 허용, D-06/D-08).
//
// 가격·수량은 전부 long 이다. 누적거래대금이 32비트를 넘고, 클라 표시 코드가 부호 있는
// 정수를 쓰기 때문이다.
table QuoteState {
    isin: string;             // 12자 ISIN
    exchange: string;         // "KRX" / "NXT"
    last_price: long;         // 현재가 (A3 tradePrice)
    open_price: long;         // 시가
    high_price: long;         // 고가
    low_price: long;          // 저가
    change: long;             // 전일대비 (부호 판정의 정본은 change_sign 이다)
    change_sign: string;      // 전일대비구분 — A3 priceChangeType **원문 1자 그대로** (D-04).
                              // 서버가 해석해서 바꾸지 않는다 (10 D-03 관례)
    change_rate: double;      // 등락률 (%)
    cum_volume: long;         // 누적거래량 (주)
    cum_value: long;          // 누적거래대금 (원)
    ask_prices: [long];       // 매도호가 1~10단계
    ask_qtys: [long];         // 매도호가 잔량 1~10단계
    bid_prices: [long];       // 매수호가 1~10단계
    bid_qtys: [long];         // 매수호가 잔량 1~10단계
    total_ask_qty: long;      // 총 매도잔량
    total_bid_qty: long;      // 총 매수잔량
    upper_limit: long;        // 상한가
    lower_limit: long;        // 하한가
    base_price: long;         // 기준가 (전일 종가)
    vi_up_price: long;        // VI 발동예상가 (상승)
    vi_down_price: long;      // VI 발동예상가 (하락)
    list_shares: long;        // 상장주식수 (A0) — 호가창 "발행" 행이 거래대금을 표시하던
                              // 결함의 수정분이다 (D-03)
    est_price: long;          // 예상체결가 — **자리만** 잡는다. 값 공급은 후속 (D-03 / Deferred)
    est_qty: long;            // 예상체결수량 — 동상 (자리만)
    exchange_time: string;    // 거래소 체결·처리시각 "HHMMSSuuuuuu" 12자 — 신선도 판정의 원천 (D-04)
    server_time: string;      // 서버 송신시각 (표시용)
    is_snapshot: bool;        // true=58 스냅샷(전량 교체), false=59 증분 푸시
    krx_close_price: long;    // 그날(서버 로컬 날짜) KRX A6 종목마감 종가 — 스탬프가 오늘이 아니면 0.
                              // NXT 프레임에도 같은 ISIN 의 KRX 종가를 싣는다. 0 = 그날 종가 없음
                              // (구 서버는 필드 부재라 역시 0). 기존 필드 번호 불변을 위한 맨 끝
                              // append (quick-260916-sjb)
    off_hours_close_ask_qty: long;  // KRX 시간외종가(G2 08:30~08:40 · G3 15:40~16:00) 매도호가 총잔량 —
                                    // B8(IFMSRPD0063) 최신값. KRX 키만 싣고 NXT 키는 늘 0, 06:00 거래일
                                    // 경계에 0. 0 = 잔량 없음·미수신(구 서버는 필드 부재라 역시 0).
                                    // 기존 필드 번호 불변을 위한 맨 끝 append (quick-260928-ccl)
    off_hours_close_bid_qty: long;  // 같은 원천의 매수호가 총잔량 — 규칙은 off_hours_close_ask_qty 와 같다
    burst_upper_limit: bool;        // 버스트 상한가 — 상한 매도잔량이 사라질 때까지의 상한가 매수체결이 전부 버스트 조각
                                    // (A3 매도1·매수1호가 0/0 으로 이어진 조각들 + 그 마지막 조각)이면 true. 서버 추적기
                                    // (server/src/market/krx/BurstLimit.h) 판정, 거래소별(KRX/NXT 각자). 58/59 매 프레임,
                                    // 상한가 이탈(B6)·06:00 에 false. 구 서버는 필드 부재라 false. 맨 끝 append (quick-261003-phd)
}

// 체결 테이프 1건 (D-02)
table TradeTapeEntry {
    trade_time: string;       // 체결시각 (거래소 원문)
    price: long;              // 체결가
    change_sign: string;      // 전일대비구분 원문 1자
    change: long;             // 전일대비
    qty: long;                // 체결수량 (주)
    cum_volume: long;         // 누적거래량 (주)
    bs_code: string;          // 최종매도매수구분 원문 1자 ('1'=매도, '2'=매수) — A3.finalBSCode.
                              // 체결내역 수량 색(매수 빨강/매도 파랑)의 원천이다. 없던 필드라
                              // **맨 끝에 append** 한다 (기존 필드 번호 불변 — debug/trade-tape-buy-color-blue)
}

// 체결 테이프 본문 — MsgType 69/71 이 Envelope 의 `trade_tape` 슬롯 하나를 공유한다 (58/59 동형).
// 서버는 종목별 최근 N건을 메모리 링버퍼로 보관하고, 조회에 스냅샷을, 이후 실시간으로 증분을
// 보낸다. 서버 기동 이후분만 있는 것은 허용이다 (D-02).
table TradeTape {
    isin: string;
    exchange: string;
    entries: [TradeTapeEntry];  // 스냅샷=보유 전량(오래된 것 → 최신 순), 증분=신규분만
    is_snapshot: bool;          // true=69 스냅샷(전량 교체), false=71 증분(뒤에 이어붙임)
}

// 종목마스터 1종목 (D-12 / D-13)
table SymbolMasterItem {
    code: string;             // 단축코드 (6자)
    name: string;             // 종목명 — **서버가 EUC-KR→UTF-8 로 변환한 값**이다 (D-13)
    isin: string;             // 12자 ISIN
    market_type: string;      // 시장구분 — 클라 기존 어휘("0"/"1")를 그대로 쓴다.
                              // 원천만 교체하고 소비처는 건드리지 않는다 (RESEARCH A5)
    sec_group_id: string;     // 증권그룹ID 2자 (A0 원문) — ETF/ETN 구분 결함의 수정분 (D-03)
    nxt_tradable: bool;       // NXT 거래가능 여부. 서버가 NXT A0 수신으로 판정한다 (D-12).
                              // false 면 클라는 호가창의 NXT 선택을 비활성화한다
}

// 종목마스터 분할 응답 본문 (Server -> Client, MsgType 57 — D-13)
// - 접속 시 전량 다운로드다. 한 프레임에 다 담으면 수 MB 라 묶음으로 쪼갠다
//   (계좌 스냅샷 66 의 "계좌당 1프레임" 선례 동형).
// - 클라는 items 를 누적하고 is_last=true 를 받으면 완료로 본다. total_items 는 진행
//   표시·수신 검증용이다.
table SymbolMaster {
    items: [SymbolMasterItem];
    seq: int;                 // 프레임 순번 (0부터)
    total_items: int;         // 전체 종목 수 (전 프레임 동일값)
    is_last: bool;            // 마지막 프레임 표식
}

// ============================================================================
// VI 자동주문 추적·확인 (quick-260903-m2c — 자동취소 서버 이관, D-03/D-06/D-17/D-18)
// ============================================================================

// VI 주문 확인 등록/해제 (33). 같은 메시지로 켜고 끈다 (D-09).
// 서버는 요청 세션(user@BROKER)이 낸 VI 주문의 order_no 만 받는다 — 타 user 주문번호는
// 미존재 취급이다 (T-m2c-01). 119초 취소가 나간 뒤(confirm_locked)의 확인은 무시하고
// 현재 항목을 에코만 한다 (D-05).
table ConfirmVIOrderReq {
    order_no: string;     // 접수 통보로 확정된 주문번호 (10자리)
    confirmed: bool;      // true=확인(119초 미확인 취소 면제), false=해제
}

// VI 추적 항목 1건 (72/73 원소). 서버 VIOrderWatch 의 VIOrderItem 을 그대로 싣는다.
table VIOrderItem {
    isin: string;             // 발동 종목 ISIN (12자)
    market: string;           // "K"=KOSPI / "Q"=KOSDAQ (R8 정보구분)
    account_no: string;       // 발주 계좌
    order_no: string;         // 주문번호. **"" = 접수 전**(Pending) — 확인 불가
    order_qty: uint;          // 주문수량
    order_price: uint;        // 주문가 (= 발주 시 마스터 상한가 — 110초 판정의 비교 대상)
    trigger_price: uint;      // VI 발동가 (R8)
    base_price: uint;         // 마스터 기준가 (전일대비 표시용)
    vi_end_time: string;      // R8 VI 해제예정시각 "HHMMSSuuu" (9자) — 클라 마감알림 기준 (D-08/D-11)
    deadline110_ms: long;     // 110초 규칙 데드라인 (epoch ms, MarketClock 기준) — 클라는 로그용
    deadline119_ms: long;     // 119초 규칙 데드라인 (epoch ms)
    confirmed: bool;          // 사람이 확인 체크를 켰는가 (서버 영속, D-06)
    confirm_locked: bool;     // 확인 변경 불가 (= 119초 규칙 적용됨 ‖ Cancelling ‖ 종료) — 클라가 재계산하지 않는다
    state: string;            // "Pending" | "Accepted" | "Cancelling" | "Cancelled" | "Filled" | "Rejected"
    filled_qty: uint;         // 누적 체결수량 (부분체결은 별 상태가 아니라 이 값 > 0)

    // === 이하 Phase 21 추가 (테이블 **말미 append** — 가운데 삽입 금지, 하위호환) ===
    exchange: string;         // "KRX" / "NXT" (Phase 21 D-10 — 72/73 공용, log/vi_orders.toml 의
                              // exchange 키와 같은 값). 빈 값 = KRX. R8 해제·연장 전문 매칭은
                              // ISIN + 거래소다 — KRX 해제가 NXT 추적을 끝내지 않는다.
                              // vtable 슬롯 34

    // === 이하 quick-260923-jsv 추가 (테이블 **말미 append** — 가운데 삽입 금지, 하위호환) ===
    vi_released: bool;        // 서버 VIOrderWatch 의 viReleased 그대로 — R8 해제 전문(viStatus '2')을
                              // 받은 시점에 선다. 종료 항목(Filled/Cancelled/Rejected)에도 선다
                              // (표시 전용 — 감시·자동취소와 무관). 재기동 때 해제예정 + 60초를
                              // 넘긴 항목은 MarkReleasedIfStale 이 보정한다. 축은 (ISIN, 거래소) —
                              // KRX 해제가 NXT 항목을 표시하지 않는다. 클라는 vi_end_time 시계로
                              // 해제를 판정하지 않는다. 구 서버 = false.
                              // vtable 슬롯 36

    // === 이하 quick-260923-jsv 후속 추가 (테이블 **말미 append** — 가운데 삽입 금지, 하위호환) ===
    created_ms: long;         // 발주 시각 (epoch ms, MarketClock 기준) — VIOrderWatch.createdMs 그대로,
                              // log/vi_orders.toml 에 영속돼 재기동에도 유지된다. 클라 VI 창 '주문시간'
                              // 표시 원천 (72 스냅샷 복원 행이 수신 시각으로 찍히던 결함). 구 서버 = 0.
                              // vtable 슬롯 38
}

// VI 추적 목록 (72 스냅샷 / 73 푸시 공용 본문).
// is_snapshot=true 는 **전량 교체**(서버에 없는 행은 클라가 지운다), false 는 항목별 upsert.
table VIOrderList {
    is_snapshot: bool;
    items: [VIOrderItem];     // 0건이어도 길이 0 벡터를 싣는다 (무응답 금지)
}

// ============================================================================
// 거래원 — 회원사별 매매 통계 (quick-260904-fi6)
//
// 원천은 KRX 접속표준서 v1.341 IFMSSTD0006(B901S/B901Q) = NXT 설계서 v1.11 IFMDOS302
// (B951S/B951Q), 414B ASCII. 단계 1~5 의 매도·매수 회원번호(5자)·체결수량·거래대금이
// 매 프레임 **전량** 실린다 (증분이 아니다). 원문에 외국계 합계·증감·비율은 **없다** —
// 클라가 표시용 파생값(5행 합·외국계 부분합)을 만든다.
// ============================================================================

// 거래원 1단계 (한쪽 방향). member_no 는 KRX 회원번호 5자 그대로 (MemberCodes 키).
table MemberStat {
    member_no: string;        // 회원번호 5자 ("00003" 등) — 클라 MemberCodes.GetMemberName 키
    qty: long;                // 체결수량 (원문 12자)
    value: long;              // 거래대금 정수부 (원문 18자 + '.' + 소수 3자 — 소수부는 버린다)
}

// 거래원 5단계 (74 스냅샷 / 75 푸시 공용 본문).
// sell/buy 는 **단계 1~5 순**이다. 0건이어도 벡터를 생성한다 (클라가 null 검사 없이 순회).
table MemberStats {
    isin: string;             // 12자
    exchange: string;         // "KRX" / "NXT" (QuoteState.exchange 와 같은 어휘 — ExchangeToStr)
    sell: [MemberStat];       // 매도 상위 5 회원
    buy: [MemberStat];        // 매수 상위 5 회원
    server_time: string;      // 서버 송신시각 "HH:MM:SS" (QuoteState.server_time 과 같은 표시용)
    is_snapshot: bool;        // true=74 스냅샷(전량 교체) / false=75 푸시 (역시 전량 — B9 특성)
}

// ============================================================================
// Phase 19 — 등락률 임계 상향 돌파 알림 (RateCrossAlert 76, S→C 푸시 전용)
//
// 서버 MarketPublisher 가 판정 대상 체결(KRX G1/G4 + KRX 접속매매 세션이 닫힌 시간의 NXT 접속매매 — 단일가 제외, quick-260923-cfo)마다
// 등락률(CalcChangeRateSignedBP)을 임계와 비교해 ISIN 당 엣지(임계 미만 → 이상)에서 접속 연결 전부에 Broadcast 로 보낸다 (D-01/D-06/D-10).
// 재무장은 등락률이 임계 − 2%p 미만일 때만이다(quick-260914-eqd — 임계 근처 반복 발송 방지).
// 서버는 돌파할 때마다 보내고, "하루 1회 자동 열기" 규칙은 클라 몫이다 (D-07).
// 푸시 전용이라 스냅샷 짝이 없다 — 스냅샷 플래그를 두지 않는다 (슬롯 하나·타입 하나, D-09).
// ============================================================================

table RateCrossAlert {
    isin: string;             // 12자 (QuoteState.isin 과 같은 키)
    exchange: string;         // "KRX" / "NXT" (QuoteState.exchange 와 같은 어휘 — ExchangeToStr; 발화한 판정 대상 체결의 거래소(76) / above 구간을 연 거래소(78), quick-260923-cfo)
    last_price: long;         // 돌파를 만든 A3 체결가
    change_rate: double;      // 등락률 % (부호 포함 = CalcChangeRateSignedBP / 100)
    threshold_pct: double;    // 서버 설정 임계 % ([market_data] rate_cross_alert_pct — 표시용, D-05)
    base_price: long;         // 기준가 — A3 체결가에서 전일대비를 되돌린 값 (마스터 기준가 아님)
    exchange_time: string;    // A3 체결시각 12자 원문 (HHMMSSuuuuuu)
    server_time: string;      // 서버 송신시각 "HH:MM:SS" (QuoteState.server_time 과 같은 표시용)
}

// ============================================================================
// quick-260914-eqd — 등락률 돌파 스냅샷 (RateCrossSnapshot 78, S→C)
//
// 서버가 로그인 성공 직후 **그 연결에만** Notice 1프레임으로 보낸다(재로그인·재접속 로그인마다).
// 클라를 늦게 켜거나 재접속해도 "지금 임계 이상인 종목" 으로 돌파 목록을 채우기 위해서다.
// items = 서버가 지금 above 로 들고 있는 종목 전부(ISIN 당 1원소, 거래소 무관). 빈 목록도 1프레임을 보낸다.
//
// 원소는 76 의 RateCrossAlert 테이블을 재사용한다. 스냅샷 원소의 필드 의미:
//   · last_price / change_rate / base_price = 그 종목의 **마지막 판정 대상 A3** 값(스냅샷 시점 최신, 거래소 무관).
//     판정 제외 A3(판정 밖 보드·NXT 단일가·KRX 열린 시간의 NXT)는 반영하지 않는다. 76 과 같은 원천(CalcChangeRateSignedBP·A3 되돌림)이다.
//   · exchange_time = **지금 above 구간을 연 A3 체결시각**(12자 원문) — 상향 돌파로 76 을 발화한 A3,
//     또는 서버 장중 기동 시드 전용(WR-01)으로 발화 없이 above 가 된 첫 A3. 시드 종목의 실제 돌파는
//     서버 기동 전 사건이라 서버가 모른다 — 시드 A3 시각은 서버가 "이상" 을 확인한 가장 이른 시각이다.
//   · threshold_pct = 서버 임계 %, exchange = above 구간을 연 거래소(quick-260923-cfo), server_time = 스냅샷 송신 시각(원소 공통).
//   · 원소 순서 = exchange_time 오름차순, 같으면 isin 오름차순.
// above 는 재무장 폭 2%p 때문에 임계 − 2%p 이상 ~ 임계 미만 원소를 포함할 수 있다 — 클라 목록 보관 구간과 같다.
//
// 76 에 스냅샷 플래그를 붙이지 않은 이유 = 구 클라는 모르는 필드를 무시하므로 원소를 **새 돌파**로 읽는다
// (상따창 자동 열기·알림음 폭주). 새 MsgType 은 구 클라 수신 switch 의 default: 가 무시한다.
// 전송은 Notice 다 — 로그인당 1회라 드롭되면 다음 로그인까지 자연 회복이 없다.
// ============================================================================

table RateCrossSnapshot {
    items: [RateCrossAlert];  // 지금 above 인 종목 전부 — 원소 exchange = above 구간을 연 거래소 (돌파 시각 오름차순, 빈 벡터 가능)
}

// ============================================================================
// Phase 23 — 관찰자(기록 전용) 연결 · 주문 저널 (gh-radar 19 인계서 §2, D-07)
//
// gh-radar relay 가 관찰자로 붙어 게이트웨이 주문 저널(전역 단조·조밀 seq)을 재생받는다.
// 이 이름·번호·필드 순서는 gh-radar relay 생성물과 Supabase 이벤트 JSON 키(dma_journal_apply)에
// 묶인 **one-way 계약**이다 — 바꾸려면 두 저장소를 동시에 개정한다 (D-07).
//
//   5  ObserverLoginReq   (C→S) 관찰자 로그인 — 로그인 전 연결에서만 받는다 (D-12)
//   79 ObserverLoginResp  (S→C) 요청 연결에만 Notice
//   80 JournalBatch       (S→C) 관찰자 연결에만 Notice + 펌프 스로틀 (D-16)
//
// 관찰자 역할(ObserverLoginReq.role, quick-260930-kg3 · gh-radar-48 합의): 0 = journal(80 수신) · 1 = quote(시세 전용).
// quote 역할은 79 뒤 78 을 받고 80 은 받지 않는다 — 대신 시세 요청 27/28/29/32/35 를 낼 수 있고 76 을 받는다.
//
// seq 류(seq·gw_time_ms·head_seq·oldest_seq·since_seq)는 전부 ulong(uint64)이다 (D-06 —
// 인계서가 허용한 uint 대신 uint64 확정). relay 의 flatc TS 생성물에서는 bigint 다.
// ============================================================================

table ObserverLoginReq {
    secret: string;          // [observer] 비밀 — 어떤 로그에도 남기지 않는다 (D-09/D-11)
    since_seq: ulong;        // 이 seq **초과**부터 보낸다 (since_seq 자체는 이미 받은 것). 0 = 보관분 처음부터
    journal_epoch: string;   // relay 가 마지막으로 본 epoch ("" = 모름 — epoch 불일치 조건에서 빠진다)
    client: string;          // "gh-radar-relay" (로그 표시용 — 서버가 64바이트·인쇄 가능 문자로 잘라 찍는다)

    // === 이하 Phase 25 추가 (테이블 말미 append — 가운데 삽입 금지, D-24) ===
    strategy_since_seq: ulong;   // 전략 이벤트 스트림의 since_seq (같은 epoch, 별도 seq 공간 — D-06). 0 = 보관분 처음부터 (vtable 슬롯 12)

    // === 이하 quick-260930-kg3 추가 (테이블 말미 append — 가운데 삽입 금지) ===
    role: ubyte;                 // 0 = journal(기본 — 필드 없는 구 relay 도 0) · 1 = quote(시세 전용 관찰자 — 저널 없음,
                                 // 시세 요청 27/28/29/32/35 허용) · 2 = admin(users.toml 원격 관리 — 4·44 만 처리,
                                 // 관찰자 비밀 그대로, Phase 29 D-01/D-02) · 그 밖 값은 거부 (vtable 슬롯 14)
}

table ObserverAccount {      // users.toml 평탄화 1행 (D-18) — 비밀번호는 절대 싣지 않는다
    dma_user_id: string;     // users.toml user_id
    account_no: string;      // LoadUsers 정규화값(NormalizeAccountNo 출력) 그대로 — 저널 레코드와 같은 함수의 출력
    name: string;            // 계좌명
    priority: int;           // users.toml priority (사용자 파일 순 × priority 오름차순으로 싣는다)
}

table ObserverLoginResp {
    success: bool;
    message: string;         // 거부 = 단일 문구 (Phase 17 D-04 동형, D-11)
    broker: string;          // "KB"/"KYOBO" (mock 은 "MOCK") — gh-radar p_gateway 원천 (D-04)
    journal_epoch: string;   // 저널 저장소 신원 (생성 시 1회, 파일 영속 — D-06). gh-radar p_epoch 원천
    head_seq: ulong;         // 로그인 시점 마지막(디스크에 쓴) seq. 같은 epoch 의 미래 seq 로 붙어도 올리기 전 실제 head
                             // (< since_seq — relay 역행 감지용, 아래 resync)
    oldest_seq: ulong;       // 메모리 재생 원천의 첫 seq. 0 = 재생 원천 없음 — 보낼 수 있는 레코드가 없다
    resync: bool;            // true = 요청 epoch 불일치 또는 보관 범위 밖(since_seq < oldest_seq − 1, oldest_seq 0 이면
                             // since_seq < head_seq). oldest_seq 부터 다시 보낸다 — 단 oldest_seq = 0 이면 보낼 레코드가
                             // 없고 전송은 다음 append(head_seq + 1)부터 시작한다 (WR-07).
                             // 같은 epoch 인데 since_seq > head_seq(게이트웨이 head 되감김)는 resync 가 아니다 — 게이트웨이가
                             // head 를 since_seq 로 올리고(다음 레코드 since_seq + 1, 같은 epoch 안 seq 재사용 없음)
                             // head_seq = 올리기 전 실제 head · oldest_seq = 0 · false 로 답한다 — relay 는 역행으로 기록하고
                             // since_seq + 1 부터 잇는다. 요청 epoch "" 의 미래 seq 만 true (D-16 · EX-01b 개정)
    accounts: [ObserverAccount];   // 실패 응답은 빈 벡터

    // === 이하 Phase 25 추가 (테이블 말미 append — 가운데 삽입 금지, D-24) ===
    // 전략 이벤트 스트림의 커서 3종 — 주문 스트림(head_seq/oldest_seq/resync)과 같은 의미, seq 공간만 다르다 (D-06).
    // epoch 는 주문 저널과 공유한다(journal_epoch 하나). strategy_resync 는 v0.1 밖 말미 추가 — relay 가 스트림별 resync 를
    // 파생하지 않게 서버가 스트림마다 판정해 준다. 전략 저널이 없으면 0/0/false.
    strategy_head_seq: ulong;      // (vtable 슬롯 20)
    strategy_oldest_seq: ulong;    // (vtable 슬롯 22)
    strategy_resync: bool;         // (vtable 슬롯 24)

    // === 이하 quick-260930-kg3 추가 (테이블 말미 append — 가운데 삽입 금지) ===
    role: ubyte;                   // 성공 응답에 수락한 역할 에코(0 = journal · 1 = quote · 2 = admin), 거부 응답은 0 (vtable 슬롯 26)
}

table JournalRecord {        // 23 필드 — gh-radar 이벤트 JSON 키와 1:1 (인계서 §2 대응표, 이름 그대로)
    seq: ulong;              // 게이트웨이 전역 단조·조밀 — 재시작·자정을 넘어 이어진다. 필터링은 seq 부여 전에
    trade_date: string;      // "YYYY-MM-DD" (KST, 발생 시각 기준)
    gw_time_ms: ulong;       // 게이트웨이 벽시계 epoch ms (발생 시각 — 재생 시각 아님)
    dma_user_id: string;     // 발주 세션 user. 모르면 "" (재기동 뒤 termId=0)
    account_no: string;      // NormalizeAccountNo 출력 그대로 (relay·DB 는 재정규화하지 않는다)
    isin: string;
    side: string;            // "B"/"S"/""
    side_trusted: bool;      // C/M 에서 원주문 메타로 side 를 채웠을 때만 true
    order_no: string;        // 로컬 거부는 "" (예약 Q-ID 회신은 Q-ID 10자)
    org_order_no: string;    // 원주문번호 없음(공백 포함)은 ""
    notice_type: string;     // A/E/C/M/R (ExecutionReport.noticeType 그대로)
    request_kind: string;    // New/Modify/Cancel/"" (RequestKindWireText)
    requester: string;       // "Manual"/"" (manualRequest)
    origin: string;          // Manual/LimitChaser/VITrigger/"" (OriginName — 모르면 "" 가 정상)
    exchange: string;        // KRX/NXT
    board: string;           // "G2"/"G3"/"" (BoardWireText, 로컬 거부는 "")
    order_price: int;        // 주문가 — 체결가를 덮어쓰지 않는다 (order/exec 분리, 51 의 useExecuted 금지)
    order_qty: int;          // 주문수량
    exec_price: int;         // 체결가 (E 가 아니면 0)
    exec_qty: int;           // 체결수량 (E 가 아니면 0)
    result_code: int;
    message: string;         // 51 과 같은 조립 문구 (804 친화 문구 교체 후) — gh-radar 는 파싱하지 않는다
    local_reject: bool;      // 거래소에 도달한 적 없는 거부 — 로컬 합성 거부 또는 Gateway 즉시 실패 회신 (order_no = "").
                             // 접수 불명(result_code -2) R 은 false (접수됐을 수 있다 — WR-01, order_no 는 역시 "")
}

table JournalBatch {
    records: [JournalRecord];   // seq 오름차순·조밀. 레코드 0건 배치는 보내지 않는다
    head_seq: ulong;            // 이 프레임 조립 시점의 head
    caught_up: bool;            // records 마지막 seq == head_seq

    // === 이하 Phase 25 추가 (테이블 말미 append — 가운데 삽입 금지, D-24) ===
    // 한 프레임에 두 스트림(주문 저널·전략 이벤트)을 함께 싣는다 — 둘 다 0건이면 프레임을 만들지 않고, 한쪽만 0건이면
    // 그 벡터를 비운 채 보낸다. caught_up/strategy_caught_up 은 각 스트림의 그 시점 커서 상태다 (D-05/D-06).
    strategy_events: [StrategyEvent];   // 전략 이벤트 seq 오름차순·조밀 (vtable 슬롯 10)
    strategy_head_seq: ulong;           // 이 프레임 조립 시점의 전략 스트림 head (vtable 슬롯 12)
    strategy_caught_up: bool;           // 전략 스트림 next−1 == strategy_head_seq (0건이면 next > head) (vtable 슬롯 14)
}

// ============================================================================
// Phase 25 — 상따 주문로그·잔량진행률 (25-HANDOFF-gh-radar-fields-v0.1, D-03/D-19)
//
// 상따 전략의 판단·주문 이벤트 7종(상한가노출·진입·매수주문·대기·첫체결·매도주문·취소·거부)을 전략 저널
// (`log/journal/strategy/`, 주문 저널과 같은 epoch·별도 seq 공간)에 쓰고 관찰자(gh-radar relay)에는 80 JournalBatch
// 말미 `strategy_events` 로, 클라에는 81(백필)/82(푸시)로 보낸다. 잔량진행률(83)은 종목·거래소별 대기 주문 전체
// 스냅샷 Broadcast 다. 필드 이름·enum 번호는 HANDOFF v0.1 로 gh-radar 와 합의된 **one-way 계약**이다 (D-03) —
// 바꾸지 않고, 추가는 말미 append 만 한다. 표시 이름(선매수·추가매수·호가매도 …)은 클라 매핑이다 (D-02).
//
//   39 GetStrategyEventsReq (C→S) 오늘분 백필 — get_quote_req 슬롯 재사용
//   81 StrategyEventsResp   (S→C) 백필 응답 (is_snapshot=true, 요청 연결에만 Notice)
//   82 StrategyEventPush    (S→C) 이벤트 1건 푸시 (is_snapshot=false, Notice)
//   83 QueueProgress        (S→C) 잔량진행률 (Broadcast)
//
// seq·gw_time_ms: seq 는 ulong(주문 저널 동형). gw_time_ms 는 HANDOFF 의 int64 를 따라 long 이다 —
// JournalRecord.gw_time_ms(ulong) 와 다르지만 relay TS 는 둘 다 bigint 다. enum 은 전부 ubyte, 0 = None/미지.
// ============================================================================

enum StrategyEventKind : ubyte {
    None = 0,
    LimitExposed = 1,    // 상한가노출 — 상한가에 매도잔량이 노출됨 (시세 이벤트, 계좌 없음)
    LimitEntered = 2,    // 상한가진입 — 매수1 == 상한가 && 매도잔량 0 (시세 이벤트, 계좌 없음)
    BuyOrder = 3,        // 매수주문 — A 접수 시점에 1건 (전송 시각은 gw_time_ms, 접수 지연은 accept_latency_us)
    Queued = 4,          // 대기 — 상한가 매수 줄서기 (base_cum/ahead_qty/expected_cum)
    FirstFill = 5,       // 첫체결 — error_volume = expected_cum − 첫 체결 시점 누적
    SellOrder = 6,       // 매도주문
    Cancelled = 7,       // 취소 — cancel_reason · remaining_volume
    Rejected = 8,        // 거부 — result_code · message
    // 9 는 gh-radar 예약 요청 중이라 비워 둔다(사용 금지).
    BurstLimit = 10,     // 버스트 상한가 — 시세 이벤트, 계좌 없음. cond_actual 조각수 · ev_trade_qty 합계수량 · ev_price 상한가 (quick-261003-phd)
    // 11~14 는 Phase 28 자동매도(group 9 AutoSell) — 28-HANDOFF §4-1 v0.2 칸 재해석(전용 필드 없음, D-33).
    // 단위: 가격 칸은 원 정수 · 수량·누적은 주 정수 · bp 없음. account_no·dma_user_id 를 반드시 채운다(계좌 이벤트).
    AutoSellTriggered = 11, // 자동매도 발동 — price 발동가 · qty 0 · cond_threshold 시작조건 N(0~9) · cond_actual 실측 체결가(원) ·
                            // cond_metric Price · ev_kind Trade(ev_price 실측가 · ev_trade_qty 체결량) · queue_case 기준 종류
                            // (1 상한가 · 2 매수가) · entry_round N · bid1_price 기준가격 · ev_qty_before 거래소 기준가(원) ·
                            // cum_volume T0 누적. reason_code AutoSellTrigger0 / AutoSellTriggerN
    AutoSellModified = 12,  // 자동매도 정정 — order_no 원주문 번호 · price 새 가격 · qty 정정 수량 · cond_threshold 원주문 가격(원) ·
                            // cond_actual 원주문 잔량(주) · cond_metric Price · message 새 주문번호(숫자만, 모르면 "") ·
                            // reason_code AutoSellModify
    AutoSellState = 13,     // 자동매도 상태 변경 — price 기준가격 · qty 누적 매도수량 · cond_threshold/cond_actual 이전/새 상태 0~4
                            // (0 없음 · 1 대기 · 2 감시 · 3 매도중 · 4 완료) · queue_case 기준 종류 · reason_code AutoSellStateChange
    AutoSellPause = 14,     // 자동매도 멈춤/재개 — cond_threshold 0 · cond_actual 1 VI · 2 동시호가 · 3 재개 · expected_cum 새 T0(재개) ·
                            // reason_code AutoSellPauseVI / AutoSellPauseAuction / AutoSellResume
    // 15 는 Phase 27 실시간 상한가 특징 — 계좌 없음, 저널 80 전용(분당 1건/키).
    LimitFeature = 15       // 실시간 상한가 특징 분당 스냅 — 시세 이벤트 아님(82 미송신), 슬롯 매핑 docs/analysis/feature-dictionary.md ③
}

enum OrderGroup : ubyte {
    None = 0,
    PreBuy = 1,          // 선매수
    AddBuy = 2,          // 추가매수 (코드 주석 "줄서기": 매수잔량 ≥ 구간 진입)
    PostBuy = 3,         // 후매수 (코드 주석 "반등": 발동잔량 ≤ 하향 래칫)
    SellQuote = 4,       // 호가매도 (ShouldSellOnQuote, B6)
    SellTrade = 5,       // 체결매도 (ShouldSellOnTrade, A3)
    SellFillHook = 6,    // 체결훅 즉시매도
    Manual = 7,          // 수동 주문 — quick-260930-e5o, gh-radar 합의 말미 append
    VITrigger = 8,       // VI 자동주문 — quick-260930-e5o, gh-radar 합의 말미 append
    AutoSell = 9         // 자동매도 — Phase 28 D-22, 28-HANDOFF §4-1 v0.2. kind 6 SellOrder 는 reason_code 로 두 변종을 가른다
                         // (아래 칸 의미는 **group 9 일 때만** — 다른 group 의 기존 의미는 그대로):
                         //  · AutoSellAsk1 / AutoSellBid1 주기 매도 — price 주문가 · qty 주문 수량 · cond_threshold 비율 %(정수) ·
                         //    cond_actual 주기 거래량(주) · cond_metric TradeQty · ev_kind Trade · ev_price 호가(ask1·bid1) ·
                         //    ev_trade_qty 주기 거래량 · ev_qty_before/after 직전 주기/이번 누적 · cum_volume 이번 누적
                         //  · AutoSellAuctionOrder 장전 동시호가 회차 — price 하한가(원) · qty 회차 주문 수량 · cond_threshold
                         //    동시호가 매도비율 정수 % · cond_actual 예상체결량(주) · cond_metric TradeQty · ev_kind Quote ·
                         //    ev_price 예상체결가(원) · ev_trade_qty 예상체결량 · entry_round 회차 1~5 · ev_qty_before/after
                         //    회차 전/후 누적 보관 수량 · cum_volume 누적(장전 0)
}

enum CondMetric : ubyte {
    None = 0,
    Ask1Qty = 1,         // 매도1 잔량
    Bid1Qty = 2,         // 매수1 잔량
    TradeQty = 3,        // 체결량
    Price = 4,           // 가격
    Burst = 5,           // 연속 체결 누적
    // 6~7 은 v0.1 밖 말미 추가 — OrderReason 과 1:1 열거 (연산자는 reason_code 로 결정)
    SweepCount = 6,      // 스윕 틱 수
    RiseRateBp = 7       // 상승률 bp
}

enum EvidenceKind : ubyte {
    None = 0,
    Quote = 1,           // 호가 (ev_price · ev_qty_before → ev_qty_after)
    Trade = 2,           // 체결 (ev_price · ev_trade_qty)
    FillNotice = 3       // 체결통보
}

enum CancelReason : ubyte {
    None = 0,
    Manual = 1,          // 수동 취소
    ExitSell = 2,        // 이탈 매도 전 매수 미체결 취소
    Bid1Drop = 3,        // 매수1 이탈
    VIWatch = 4,         // VIOrderWatch 자동취소
    Exchange = 5,        // 거래소 자동취소
    Close = 6,           // 마감정리 (15:40/20:00)
    // 7~9 는 v0.1 밖 말미 추가 — 서버 취소 경로 1:1
    SellTradeQty = 7,    // 체결량·버스트·재평가 얇은 벽 취소 (CancelTradeQty/CancelBurstSellQty/CancelRecalcBidThin)
    RejectResell = 8,    // 취소 거부(804) 재취소 (CancelRejectResell)
    Other = 9,           // 그 밖
    // 10~11 은 Phase 28 자동매도 신규 값(기존 값 재사용 없음, 라벨은 gh-radar — D-33). 자동매도 발동 선취소는 2 ExitSell 그대로.
    AutoSellBuyFirst = 10,    // 자동매도 매수 우선 — 같은 창 매수 조건 성립 시 그 계좌·종목 매도 미체결(거래소 불문) 취소 (D-09/D-31)
    AutoSellAuctionTrim = 11  // 자동매도 장전 동시호가 회차 감축 — 목표 수량이 줄어 나중 주문부터 취소 (D-29)
}

table StrategyEvent {            // 43 필드 — HANDOFF v0.1 표 순서·이름 그대로 (없는 값은 0/"")
    seq: ulong;                  // 전략 이벤트 seq (조밀·단조, 주문 저널과 별도 공간)
    trade_date: string;          // YYYY-MM-DD KST
    gw_time_ms: long;            // 발생 epoch ms (주문 이벤트 = 전송 직전 시각). 저널과 같은 이름
    kind: StrategyEventKind;     // 1 LimitExposed ~ 8 Rejected
    group: OrderGroup;           // 0 None · 1 PreBuy · 2 AddBuy · 3 PostBuy · 4 SellQuote · 5 SellTrade · 6 SellFillHook
    exchange: string;            // KRX / NXT (판단에 쓴 시세의 거래소 = 발주 거래소)
    isin: string;
    cum_volume: ulong;           // 이벤트 시점 그 거래소 누적거래량 (A3 최신값)
    dma_user_id: string;         // 주문 이벤트만 (시세 이벤트는 "")
    account_no: string;          // 주문 이벤트만 (시세 이벤트는 "")
    order_no: string;            // 없으면 "" (거부·시세 이벤트)
    price: int;                  // 주문가 (주문 이벤트)
    qty: int;                    // 주문수량 (주문 이벤트)
    order_condition: string;     // "0" 지정가 등 (매도주문 「방식」)
    reason_code: string;         // 서버 OrderReasonName 원문 (B6Buy3, A3Buy4, B6Sell1 …) — 판정 키
    cond_threshold: long;        // 조건 설정값 (「조건: 매도잔량≤50,000」의 50,000)
    cond_actual: long;           // 실측값 (38,200)
    cond_metric: CondMetric;     // 1 Ask1Qty · 2 Bid1Qty · 3 TradeQty · 4 Price · 5 Burst · 6 SweepCount · 7 RiseRateBp
    ev_kind: EvidenceKind;       // 1 Quote · 2 Trade · 3 FillNotice
    ev_price: int;               // 근거 틱 가격
    ev_qty_before: long;         // 호가면 잔량 변화 전 (52,100)
    ev_qty_after: long;          // 호가면 잔량 변화 후 (38,200)
    ev_trade_qty: long;          // 체결이면 체결량
    limit_bid_qty: long;         // 그 시점 상한가 매수잔량 (bid1==상한가일 때 bid1 잔량, 아니면 0)
    bid1_price: int;             // 매도주문: 매수1 가격
    bid1_qty: long;              // 매도주문: 매수1 잔량
    accept_latency_us: int;      // 전송→접수 통보 (0 = 미측정). BuyOrder 는 접수 시점에 쓴다 (전송 시각은 gw_time_ms)
    immediate_fill_qty: long;    // 즉시체결 분 (0 이면 없음)
    queue_case: byte;            // 1 잔량 보고 낸 주문 · 2 잔량 쌓이기 전 주문
    base_cum: ulong;             // 대기: 기준 누적
    ahead_qty: ulong;            // 대기: 내 앞 물량
    expected_cum: ulong;         // 대기: 체결예상 누적
    error_volume: long;          // 첫체결: expected_cum − 첫 체결 시점 누적 (부호 있음)
    remaining_volume: long;      // 취소: expected_cum − 취소 시점 누적 (대기 아니었으면 0 — has_remaining 으로 구분)
    has_remaining: bool;         // remaining_volume 유효 여부
    cancel_reason: CancelReason; // 1 Manual · 2 ExitSell · 3 Bid1Drop · 4 VIWatch · 5 Exchange · 6 Close · 7~9 서버 취소 경로
    result_code: int;            // 거부: 거래소·증권사 코드
    message: string;             // 거부: 거래소·증권사 문구 그대로
    entry_round: int;            // 상한가진입 회차
    snap_qty: [long];            // 상한가진입: 즉시·1초·3초 매수잔량 (길이 0~3 — 3초 전 이탈하면 길이<3)
    snap_cum: [long];            // 상한가진입: 즉시·1초·3초 누적 (snap_qty 와 같은 길이)
    ask_qty_at_limit: long;      // 상한가노출: 상한가 매도잔량
    open_at_limit: bool;         // 시초 상한가
}

table StrategyEventBatch {       // 81/82 공용 본문 (66/67 동형)
    events: [StrategyEvent];     // 81 = 오늘분 seq 오름차순 · 82 = 1건
    is_snapshot: bool;           // true = 81 백필, false = 82 푸시
}

table QueueProgressItem {        // 그 (isin, exchange) 의 대기 또는 첫 체결 뒤 남은 주문 1건
    account_no: string;          // 필수 — relay 계좌 권한 게이트
    dma_user_id: string;
    order_no: string;
    exchange: string;            // KRX / NXT
    isin: string;
    group: OrderGroup;
    expected_cum: ulong;         // 체결예상 누적
    current_cum: ulong;          // 현재 누적거래량 (서버가 진실 원본)
    remaining_volume: long;      // expected_cum − current_cum
    progress_bp: int;            // 진행률 bp (0~10000)
    first_filled: bool;          // 첫 체결이 났다 — true 면 expected_cum·current_cum·remaining_volume·progress_bp 는 첫 체결 순간 값으로 고정(current_cum = 그 순간 누적), 전량 체결·취소·정정·거부 때 빠진다. 기본 false (quick-260930-e5g)
}

table QueueProgress {            // 83 본문 — 종목·거래소별 대기·첫 체결 뒤 주문 **전체 스냅샷** (1초 스로틀 Broadcast, D-19)
    isin: string;
    exchange: string;
    items: [QueueProgressItem];  // 빈 벡터 허용 = 전부 사라짐 (항목이 first_filled 로 바뀌거나 전량 체결·취소·정정·거부로 빠진 뒤 한 번 더 나간다)
}

// ============================================================================
// Phase 27 — 실시간 상한가 특징 (27-CONTEXT D-16/D-17/D-19, 27-RESEARCH §B-2)
//
//   85 LimitFeature (S→C) — Envelope.limit_feature 슬롯 90. 요청 짝 없음(76 선례), 키(isin, 거래소)를 FULL 구독한
//                            연결에만 1초 스로틀 Broadcast(75 선례 — 파생 표시값이라 드롭돼도 다음 초에 복구).
// 필드 이름·단위·식의 정본은 docs/analysis/feature-dictionary.md(특징 사전) — 이름은 밤 격자 열과 같고 「85 필드」 열과
// 1:1 이다. 소수 값은 bp(1% = 100), 초는 정수다. 라벨(break_within_n 등 미래값)은 싣지 않는다(누출 금지).
// 출처: 대부분 실측, member_* 는 추정(분 단위), p_*·team_sim 은 모형 — 클라 표시는 이 출처를 따른다.
// 정의 변경은 feature_schema 를 올린다(사전 「판 번호 규칙」). 이름·번호는 gh-radar 와의 one-way 계약 — 추가는 말미 append 만.
// lock_sell_krw·lock_cancel_krw 는 2026-10-06 말미 append(quick-261006-f1j) — 저널 kind 15 슬롯에는 싣지 않는다(슬롯 매핑 무변경).
// ============================================================================

table MemberDelta {              // 이 분 B9 증분 창구 1건 (상위 3, 금액 가중)
    member_no: string;           // 회원사 번호
    d_qty: long;                 // 이 분 증분 수량(주) — 현재 전량 − 분 시작 전량
    d_value: long;               // 이 분 증분 금액(원)
    share_bp: int;               // 그 쪽(매수/매도) 증분 금액 중 비중 bp (0~10000)
}

table TeamSim {                  // 팀 유사도 1건 (모형 — 승격 전엔 빈 벡터)
    label: string;               // 팀(센트로이드) 이름
    sim_bp: int;                 // 현재 분 창구 비중 벡터 ↔ 센트로이드 코사인 bp
}

table LimitFeature {             // 85 본문 — 실시간 상한가 특징 1키 스냅샷 (1초 스로틀 Broadcast, D-17)
    isin: string;                // 종목 ISIN (사전 isin)
    exchange: string;            // "KRX" / "NXT" — 키의 거래소
    gw_time_ms: long;            // 관측 시각 epoch ms (사전 t_ns 의 ms 판 — 1초 틱 시각)
    feature_schema: ubyte;       // 특징 사전 판 번호 (v1 = 1)
    upper_px: uint;              // 상한가 U(원) — 마스터 사본, 0 = 미상
    last_px: uint;               // 현재가(원)
    rate_bp: int;                // 등락률 bp (사전 rate × 10000, 하락은 음수)
    base_px: uint;               // 기준가(원) — 마스터 사본
    list_shares: ulong;          // 상장주식수(주) — 시가총액은 list_shares × base_px 로 계산
    q_qty: ulong;                // 상한가 매수잔량(주)
    q_krw: ulong;                // 상한가 매수잔량 금액(원) = q_qty × upper_px
    wall_krw_visible: ulong;     // 상한가까지 남은 매도벽 금액(원, 보이는 10단계)
    wall_qty_hidden: ulong;      // 10호가 밖 매도 수량(주, 가격 미상)
    wall_truncated: bool;        // 상한가가 10호가 밖이라 매도벽이 잘림
    sell_led_10s: ulong;         // 지난 10초 매도 주도 체결량(주)
    buy_led_10s: ulong;          // 지난 10초 매수 주도 체결량(주)
    cancel_10s: long;            // 지난 10초 상한가 잔량 취소(주, 하한)
    new_10s: long;               // 지난 10초 상한가 잔량 신규(주, 하한)
    auction_fill_10s: ulong;     // 지난 10초 단일가 체결로 빠진 상한가 잔량(주)
    drain_s: int;                // 소진 예상 시간(정수 초) — −1 = ∞(분모 0)
    lock_state: ubyte;           // 잠김 상태 0 미도달 · 1 잠김 · 2 도달 뒤 비잠김
    lock_elapsed_s: int;         // 이번 잠김 경과(정수 초) — lock_state != 1 이면 0
    burst_upper_limit: bool;     // 버스트 상한가(상한 매도벽을 0/0 버스트 조각만으로 소진, BurstLimit.h)
    auction: bool;               // 단일가 구간(VI·동시호가·NXT 단일가) — 값은 직전 유지, 클라는 「단일가」 표시
    member_buy: [MemberDelta];   // 이 분 B9 매수 증분 상위 3 (사전 member_buy_top3, 추정(분 단위))
    member_sell: [MemberDelta];  // 이 분 B9 매도 증분 상위 3 (사전 member_sell_top3, 추정(분 단위))
    member_delta_partial: bool;  // 창구가 5단계 밖으로 빠져 증분 일부 미상(0 으로 둠)
    model_state: ubyte;          // 확률 모델 상태 0 관찰 중(파일 없음·빈 파일·파싱 실패) · 1 적용
    model_schema_version: ushort; // 적용 중인 모델 파일의 schema_version (model_state 0 이면 0)
    p_break_bp: int;             // N초 안 깨짐 확률 bp — −1 = 없음(model_state 0)
    p_horizon_s: int;            // 확률의 창 N(초) — model_state 0 이면 0
    team_sim: [TeamSim];         // 팀 유사도 (모형 — 승격 전 빈 벡터)
    // === 이하 quick-261006-f1j 추가 (테이블 말미 append — 기존 필드 순서 불변, 저널 kind 15 슬롯에는 싣지 않는다) ===
    lock_sell_krw: ulong;        // 이번 잠김 누적 매도 주도 상한가 체결 금액(원) — AtLimit run 시작부터(첫 3초 포함), 30틱 확정 전 run 은 싣지 않음, 잠김이 끝나면 마지막 값 유지, 오늘 잠김 없으면 0 (quick-261006-f1j)
    lock_cancel_krw: ulong;      // 같은 창의 상한가 매수잔량 취소 금액(원, 하한) — cancel_10s 와 같은 접속매매 음수 순유입 × upper_px (quick-261006-f1j)
}

// ============================================================================
// Phase 28 — 자동매도(체결매도) (28-CONTEXT D-18~D-27, 28-HANDOFF §4-1 v0.2)
//
// 상따 전략의 자동매도 설정은 SetLimitChaser 말미 8필드(vtable 140~154)로 오가고, 그 밖 새 와이어는 셋이다.
//   41 AutoSellCommandReq (C→S) 바로시작/중지 — Envelope.auto_sell_command_req 슬롯 86. 성공 = 60 에코,
//                                실패 = 54 ERROR source "AutoSellCommand" + isin (D-19/D-25)
//   42 SetUserSettingsReq (C→S) 사용자 설정 저장 — Envelope.user_settings 슬롯 88 (84 와 공유, 81/82 선례)
//   43 GetUserSettingsReq (C→S) 사용자 설정 조회 — 요청 테이블 없음 (24/27/34 선례)
//   84 UserSettingsResp   (S→C) 사용자 설정 — 로그인 직후 그 연결 Notice + 42 뒤 같은 dma_user_id 전 세션 Notice +
//                                43 응답 (D-26)
// 자동매도 주문·상태 이벤트는 StrategyEvent(group 9 AutoSell · kind 11~14)로 저널 80 과 세션 81/82 둘 다 간다.
// 이름·번호는 gh-radar 와 합의된 one-way 계약이다 — 바꾸지 않고, 추가는 말미 append 만 한다.
// ============================================================================

table AutoSellCommandReq {       // 41 본문 — 자동매도 바로시작/중지 (D-19)
    isin: string;                // 종목 ISIN (12자리)
    account_no: string;          // 계좌번호 — 세션 선언 계좌가 아니면 54 ERROR
    exchange: string;            // "KRX" / "NXT" (빈 값 = KRX, Phase 21 D-03 어휘) — 그 거래소의 상따 전략에 적용
    action: ubyte;               // 1 Start(바로시작 — 체크 ON 보장 + 상한가 기준 매도중 전이) · 2 Stop(중지 — 체크 OFF, 미체결 유지).
                                 // 그 밖 값은 54 ERROR
}

table UserSettings {             // 42/84 공용 본문 — 사용자(dma_user_id)별 상따 기본설정 11개 + present (D-20)
    // 기존 클라 settings.ini [LimitChaserDefaults] 7키 — 금액 3칸 단위는 **만원**(클라 LimitChaserDefaults 와 같다)
    pre_buy_amount: uint;        // 선매수 주문금액(만원) 0~999999999
    add_buy_amount: uint;        // 추가매수 주문금액(만원) 0~999999999
    post_buy_amount: uint;       // 후매수 주문금액(만원) 0~999999999
    post_buy_max_count: ubyte;   // 후매수 최대 횟수(최초 포함) 0~255
    post_buy_floor_qty: uint;    // 후매수 하한잔량(주) 0~99999999
    post_buy_rebound_pct: ubyte; // 후매수 반등률 % 0~100
    sell_qty_track_ratio: ubyte; // 매도잔량 추적 비율 % 0~90
    // 신규 4 (Phase 28)
    auto_sell_period_sec: ubyte;         // 자동매도 매도 주기(초) 1~60, 기본 3 — 전략 실행 때 소유 사용자 값을 직접 읽는다
    auction_sell_ratio_pct: ubyte;       // 장전 동시호가 매도비율 % 1~50, 기본 20
    auto_sell_ratio_default_pct: ubyte;  // 상따창 자동매도 비율 기본값 % 1~50, 기본 10
    auto_sell_method_default: ubyte;     // 상따창 자동매도 방법 기본값 1 매도1호가 · 2 매수1호가 · 3 절반절반, 기본 3
    present: bool;               // **84 전용** — true = 서버 저장값 있음 · false = 저장값 없음(내장 기본값을 싣는다 —
                                 // 클라는 false 면 ini 값으로 42 를 1회 보내 이전한다, D-20). 42 요청값은 서버가 읽지 않는다
}

// ============================================================================
// Phase 29 — 원격 유저·계좌 관리 admin 역할 (29-CONTEXT D-04~D-20, gh-radar-34 합의 2026-10-06)
//
// gh-radar 웹앱 Admin 화면이 relay 의 관리자 연결(ObserverLoginReq role 2, 관찰자 비밀 그대로 — D-01)로
// 게이트웨이의 config/users.toml 유저·비밀번호·계좌를 원격 관리한다. 새 와이어는 셋이다.
//   44 AdminCommandReq    (C→S) 명령 — Envelope.admin_command_req 슬롯 92. admin 연결 전용(사용자 세션 = 86 code 11)
//   86 AdminCommandResp   (S→C) 응답 — Envelope.admin_command_resp 슬롯 94, 요청 연결에만 Notice
//   87 AdminUsersSnapshot (S→C) 전체 목록 — Envelope.admin_users_snapshot 슬롯 96, 요청 연결에만 Notice.
//                                op 5 응답 · 변경 op 가 실제 변경을 냈을 때만 86 다음 1회 (D-06)
// 적용 순서는 검증 → users.toml 재작성 → 메모리 교체(저장 실패면 메모리도 그대로, code 10 — D-08).
// 비밀번호는 86·87·로그 어디에도 싣지 않는다 (D-07).
// 이름·번호는 gh-radar 와 합의된 one-way 계약이다 — 바꾸지 않고, 추가는 말미 append 만 한다.
// 새 메시지·역할은 append-only 라 strategy_state.toml·account_state.toml·vi_orders.toml·예약주문 복원 경로를 건드리지 않는다 (D-19).
// ============================================================================

table AdminAccount {             // 계좌 1행 — 44 의 account · 87 의 AdminUser.accounts 공용
    account_no: string;          // 계좌번호. 서버가 NormalizeAccountNo(앞 0 제거, ≤12자)로 정규화하고 87 에는 정규화값이 실린다
    name: string;                // 계좌명 — 선택(빈 문자열 허용)
    branch_no: string;           // 지점번호 — KB 는 5자 필수 · 교보는 빈 문자열 허용(검사·전문 사용 없음)
    trader_id: string;           // 조작자 ID — KB 는 6자 필수 · 교보는 빈 문자열 허용(검사·전문 사용 없음)
    priority: int;               // 표시 순서 — 기본 0, 작을수록 앞 (users.toml priority)
}

table AdminCommandReq {          // 44 본문 — admin 관찰자 연결 전용 명령 (D-04, D-09~D-16)
    request_id: ulong;           // relay 가 매기는 요청 번호 — 86/87 에 그대로 에코
    op: ubyte;                   // 1 UpsertUser · 2 DeleteUser · 3 SetAccount · 4 RemoveAccount · 5 ListUsers. 그 밖 값은 86 code 1
    user_id: string;             // 대상 users.toml user_id (op 1~4). op 5 는 읽지 않는다
    password: string;            // op 1 만 — 기존 유저 + 빈 문자열 = 비밀번호 유지, 신규 유저는 필수(빈 값이면 code 3)
    account: AdminAccount;       // op 3(추가 또는 같은 account_no 갱신) · op 4(account_no 만 읽음) ·
                                 // op 1 신규(첫 계좌 필수 — 계좌 0개 유저 불허, 없으면 code 5). op 1 기존 유저는 무시
}

table AdminCommandResp {         // 86 본문 — 44 응답 (요청 연결에만 Notice)
    request_id: ulong;           // 44 의 request_id 에코
    ok: bool;                    // code == 0
    code: ushort;                // 분기용 결과 코드 (D-05):
                                 //   0 OK · 1 BAD_OP · 2 BAD_USER_ID(빈/8B 초과) · 3 BAD_PASSWORD(신규인데 빈 값) ·
                                 //   4 NO_SUCH_USER · 5 BAD_ACCOUNT_NO(빈/12자 초과/신규 유저에 account 없음) ·
                                 //   6 BAD_BRANCH_TRADER(KB 만) · 7 ACCOUNT_CONFLICT(다른 유저가 같은 계좌를 다른 branch/trader 로 보유) ·
                                 //   8 NO_SUCH_ACCOUNT · 9 BUSY(계좌에 상따·VI·미체결·예약 — 서버는 대신 정리하지 않는다) ·
                                 //   10 PERSIST_FAILED(파일 저장 실패 — 메모리도 그대로) · 11 NOT_ADMIN(사용자 세션 연결) ·
                                 //   12 LAST_ACCOUNT(마지막 계좌 제거 — 사용자 삭제로 처리)
    message: string;             // 한국어 사용자 문장(Admin 화면 표시용 — 예 「미체결 2건 · 상따 1건 · VI 1건 등록 — 먼저 정리」).
                                 // 분기는 code 로 한다
    users_rev: ulong;            // 목록 리비전 — 기동 1 · 실제 변경마다 +1 (메모리 카운터, 재기동 시 1 로 복귀 —
                                 // relay 는 접속마다 op 5 로 전체 대조). 멱등(무변경)은 code 0 · rev 불변 · 파일 안 씀 (D-06/D-09)
}

table AdminUser {                // 87 의 유저 1행 — 비밀번호는 어디에도 싣지 않는다 (D-07)
    user_id: string;             // users.toml user_id
    accounts: [AdminAccount];    // 그 유저의 계좌 — priority 오름차순(LoadUsers 정렬 그대로)
}

table AdminUsersSnapshot {       // 87 본문 — users.toml 전체 (WinForms 전용 유저 포함, D-16)
    users_rev: ulong;            // 이 목록의 리비전 (86 의 users_rev 와 같은 카운터)
    users: [AdminUser];          // 유저는 파일 순 · 계좌는 priority 오름차순. 유저 0명이면 빈 벡터
}

// ============================================================================
// Envelope (메시지 래퍼)
// ============================================================================

table Envelope {
    msg_type: MsgType;
    login_req: LoginReq;
    login_resp: LoginResp;
    order_resp: OrderResp;
    trade_execution: TradeExecution;
    server_message: ServerMessage;
    set_limit_chaser: SetLimitChaser;
    set_vi_trigger: SetVITrigger;
    // (예약) 구 set_after_hour / set_after_hour_auction 슬롯 — 재사용 금지 (Phase 6 삭제)
    //
    // ★ 지우지 않고 deprecated 로 남긴다. FlatBuffers 는 테이블 필드 id 를 **선언 순서로**
    //   부여하므로 가운데 필드를 지우면 뒤 필드(direct_order_req 이하)의 슬롯이 전부 한 칸씩
    //   밀린다. 그러면 아직 갱신되지 않은 클라이언트가 보낸 주문·계좌 메시지를 서버가
    //   엉뚱한 필드로 읽는다 — 실계좌에서 그대로 오주문이다.
    //   deprecated 필드는 접근자가 생성되지 않으므로 코드에서는 이미 사라진 것과 같다.
    //   타입은 슬롯 유지를 위한 자리표시일 뿐이다 (구 테이블은 삭제됨).
    reserved_after_hour: GetStrategyReq (deprecated);
    reserved_after_hour_auction: GetStrategyReq (deprecated);
    direct_order_req: DirectOrderReq;
    order_confirm: OrderConfirm;
    update_account_no_req: UpdateAccountNoReq;
    update_account_no_resp: UpdateAccountNoResp;
    live_ping: LivePing;
    get_strategy_req: GetStrategyReq;
    vi_order_notice: VIOrderNotice;   // Phase 11.1 말미 append — 가운데 삽입 금지

    // Phase 12 말미 append — 가운데 삽입 금지 (D-02/D-12)
    limit_chaser_list: LimitChaserList;              // 상따 열거 응답 본문 (슬롯 38)
    disable_strategies_req: DisableStrategiesReq;    // 일괄/단건 비활성화 요청 (슬롯 40)
    disable_strategies_resp: DisableStrategiesResp;  // 비활성화 집계 응답 (슬롯 42)

    // Phase 13 말미 append — 가운데 삽입 금지 (D-02/D-05/D-13)
    get_account_state_req: GetAccountStateReq;              // 계좌 상태 스냅샷 조회 요청 (25)
    account_state: AccountState;                            // 66/67 공용 본문 — 스냅샷·델타가 같은 슬롯을
                                                            // 쓴다 (에코/열거가 set_limit_chaser 를 공유하는 선례 동형)
    reconcile_account_state_req: ReconcileAccountStateReq;  // 원장 대사 업로드 (26)
    reconcile_account_state_resp: ReconcileAccountStateResp;// 원장 대사 집계 응답 (68)

    // === 이하 Phase 15 추가 (테이블 **말미 append** — 가운데 삽입 금지, D-02~D-07/D-12/D-13) ===
    // GetSymbolMasterReq(27) 은 인자가 없어 요청 슬롯을 두지 않는다 (GetLimitChaserListReq(24) 선례).
    get_quote_req: GetQuoteReq;                  // 시세 스냅샷 조회 요청 (28)
    subscribe_quote_req: SubscribeQuoteReq;      // 종목 시세 구독/해제 요청 (29)
    get_trade_tape_req: GetTradeTapeReq;         // 체결 테이프 스냅샷 조회 요청 (32)
    quote_state: QuoteState;                     // 58/59 공용 본문 — 스냅샷·푸시가 같은 슬롯을 쓴다
                                                 // (account_state 가 66/67 을 공유하는 선례 동형)
    trade_tape: TradeTape;                       // 69/71 공용 본문 — 스냅샷·증분이 같은 슬롯을 쓴다
    symbol_master: SymbolMaster;                 // 종목마스터 분할 응답 본문 (57)

    // === 이하 quick-260903-m2c 추가 (테이블 **말미 append** — 가운데 삽입 금지, D-17) ===
    // GetVIOrderListReq(34) 는 인자가 없어 요청 슬롯을 두지 않는다 (24/27 선례).
    confirm_vi_order_req: ConfirmVIOrderReq;     // VI 주문 확인 등록/해제 요청 (33)
    vi_order_list: VIOrderList;                  // 72/73 공용 본문 — 스냅샷·푸시가 같은 슬롯을 쓴다
                                                 // (account_state 가 66/67 을 공유하는 선례 동형)

    // === 이하 quick-260904-fi6 추가 (테이블 **말미 append** — 가운데 삽입 금지) ===
    // GetMemberStatsReq(35) 는 get_quote_req 슬롯을 재사용하므로 요청 슬롯을 두지 않는다.
    member_stats: MemberStats;                   // 74/75 공용 본문 — 스냅샷·푸시가 같은 슬롯을 쓴다
                                                 // (trade_tape 가 69/71 을 공유하는 선례 동형)

    // === 이하 Phase 19 추가 (테이블 **말미 append** — 가운데 삽입 금지) ===
    // RateCrossAlert(76) 은 푸시 전용이라 요청 슬롯이 없다 (스냅샷 짝도 없음 — D-09).
    rate_cross_alert: RateCrossAlert;            // 76 본문 — 등락률 임계 상향 돌파 알림 (vtable 슬롯 70)

    // === 이하 Phase 18.1 G5/G6 추가 (테이블 **말미 append** — 가운데 삽입 금지) ===
    queued_window_state: QueuedWindowState;      // 예약 구간 상태 본문 (77) (vtable 슬롯 72)

    // === 이하 quick-260914-eqd 추가 (테이블 말미 append — 가운데 삽입 금지) ===
    rate_cross_snapshot: RateCrossSnapshot;      // 78 본문 — 등락률 돌파 스냅샷 (vtable 슬롯 74)

    // === 이하 Phase 23 추가 (테이블 말미 append — 가운데 삽입 금지, D-07) ===
    observer_login_req: ObserverLoginReq;        // 5 본문 — 관찰자 로그인 요청 (vtable 슬롯 76)
    observer_login_resp: ObserverLoginResp;      // 79 본문 — 관찰자 로그인 응답 (vtable 슬롯 78)
    journal_batch: JournalBatch;                 // 80 본문 — 주문 저널 배치 (vtable 슬롯 80)

    // === 이하 Phase 25 추가 (테이블 말미 append — 가운데 삽입 금지, D-24) ===
    // GetStrategyEventsReq(39) 는 get_quote_req 슬롯을 재사용하므로 요청 슬롯을 두지 않는다 (35 선례).
    strategy_event_batch: StrategyEventBatch;    // 81/82 공용 본문 — 백필·푸시가 같은 슬롯을 쓴다 (vtable 슬롯 82)
    queue_progress: QueueProgress;               // 83 본문 — 잔량진행률 (vtable 슬롯 84)

    // === 이하 Phase 28 추가 (테이블 말미 append — 가운데 삽입 금지, D-24) ===
    // GetUserSettingsReq(43) 는 인자가 없어 요청 슬롯을 두지 않는다 (24/27/34 선례).
    auto_sell_command_req: AutoSellCommandReq;   // 41 본문 — 자동매도 바로시작/중지 (vtable 슬롯 86)
    user_settings: UserSettings;                 // 42/84 공용 본문 — Set 요청·응답/푸시가 같은 슬롯을 쓴다 (vtable 슬롯 88)

    // === 이하 Phase 27 추가 (테이블 말미 append — 가운데 삽입 금지, D-24) ===
    limit_feature: LimitFeature;                 // 85 본문 — 실시간 상한가 특징 (vtable 슬롯 90)

    // === 이하 Phase 29 추가 (테이블 말미 append — 가운데 삽입 금지, D-04) ===
    admin_command_req: AdminCommandReq;          // 44 본문 — 원격 유저·계좌 관리 명령 (vtable 슬롯 92)
    admin_command_resp: AdminCommandResp;        // 86 본문 — 명령 응답 (vtable 슬롯 94)
    admin_users_snapshot: AdminUsersSnapshot;    // 87 본문 — users.toml 전체 목록 (vtable 슬롯 96)
}

root_type Envelope;

// ============================================================================
// === Phase 16 (NXT 주문 라우팅) 변경 요약: OrderResp·UnfilledState·TradeExecution
//     exchange 말미 append + MsgType 30/31/70 재사용 금지 봉인 ===
//
// 새 테이블·새 Envelope 슬롯·새 MsgType 은 하나도 없다. 거래소 축은 기존 10/20/60/51/66/67
// 메시지의 exchange 필드로만 흐른다 (NXT-06).
// ============================================================================

// ============================================================================
// === Phase 21 (NXT VI 자동주문) 변경 요약: SetVITrigger·VIOrderNotice·VIOrderItem
//     exchange 말미 append (vtable 슬롯 14/24/34) + GetStrategyReq.key 거래소 재해석 ===
//
// 새 테이블·새 Envelope 슬롯·새 MsgType 은 하나도 없다. 거래소 축은 기존 11/61(SetVITrigger)·
// 56(VIOrderNotice)·72/73(VIOrderItem) 의 exchange 필드와 21(GetStrategyReq.key) 로만 흐른다
// (NVI-04). 어휘는 "KRX"/"NXT" 3글자이고 **빈 값·미지정 = KRX** 다 — 구 클라와 구 상태파일이
// 마이그레이션 없이 KRX 설정으로 읽힌다 (D-03/D-10). 슬롯 14/24/34 는 폐기해도 재사용 금지.
// ============================================================================
