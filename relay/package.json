{
  "name": "@gh-radar/relay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "//files": "Dockerfile 의 `pnpm --prod --legacy deploy /out` 가 담을 내용. 명시하지 않으면 pnpm 이 relay/.gitignore 를 .npmignore 로 대신 읽어 `dist/` 를 통째로 빼 버리고, 그 결과 `COPY --from=builder /out/dist` 가 not found 로 실패한다(server/ 는 .gitignore 가 없어 우연히 통과한다).",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch -r dotenv/config src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@gh-radar/shared": "workspace:*",
    "@google-cloud/pino-logging-gcp-config": "^1.3.3",
    "@supabase/supabase-js": "^2.103.0",
    "express": "^5.2.1",
    "flatbuffers": "^25.9.23",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "ws": "^8.21.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "dotenv": "^16.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.4"
  }
}
