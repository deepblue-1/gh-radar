# GH Trade iOS 릴리스 lane (Phase 22 · D-07 · D-09 · D-09a · D-10)
#
# 실행은 `pnpm --filter @gh-radar/mobile run native:release:ios` 로만 한다 —
# cap sync(양 플랫폼) → verify-prod(PROD CONFIG OK) → scripts/release-ios.sh(env 로드) → 이 lane.
#
# 흐름: ASC API 키 → App Store 프로파일(sigh, 없으면 생성) → Release archive(자동 서명)
#       → App Store 프로파일로 수동 export → check-ipa(업로드 전 게이트) → TestFlight 업로드(내부 그룹 자동 배포).
# check-ipa 는 반드시 export 와 업로드 사이에 돈다 — 내부 그룹은 자동 배포라 업로드 뒤 검사는
# 테스터 기기로 나가는 걸 막지 못한다(22-REVIEW CR-01 · Android firebase lane 의 check-apk 와 같은 구조).
# 빌드 번호는 xcargs 로 빌드 설정만 덮어쓴다 — 프로젝트 파일은 건드리지 않는다.
# 산출물(.ipa · .dSYM.zip · .mobileprovision · build_number.txt)은 GHTRADE_RELEASE_OUT(저장소 밖)에만 떨어진다.
#
# lane 목록:
#   beta    Release archive → App Store 프로파일 export → TestFlight 업로드 (래퍼 기본 모드)
#   latest  조회 전용 — 최신 TestFlight 빌드 번호 + 처리 상태 한 줄
#           「latest TestFlight build {번호} state {PROCESSING|FAILED|INVALID|VALID|UNKNOWN}」
#           빌드·서명·업로드 없음 · GHTRADE_RELEASE_OUT 에 쓰지 않음 (22-06 · 22-09 가 이 줄을 grep 한다)
require File.expand_path("../../../fastlane/build_numbers.rb", __dir__)
require "fileutils"

default_platform(:ios)

platform :ios do
  desc "Release archive(자동 서명) → App Store 프로파일 export → TestFlight 내부 그룹"
  lane :beta do
    # 값은 출력하지 않는다 — 비어 있는 키 이름만.
    missing = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH GHTRADE_RELEASE_OUT].select { |k| ENV[k].to_s.empty? }
    UI.user_error!("환경변수 비어 있음: #{missing.join(' ')} — ~/.config/gh-trade/release/ios.env") unless missing.empty?

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
      in_house: false
    )

    build_number = GhTradeBuildNumbers.ios_build_number # D-09 — 커밋하지 않는다
    out = ENV["GHTRADE_RELEASE_OUT"]                    # 저장소 밖 경로
    FileUtils.mkdir_p(out)
    File.write(File.join(out, "build_number.txt"), build_number)
    UI.message("CFBundleVersion #{build_number}")

    # 첫 실행에 "com.ghtrade.app AppStore" 를 만들고 이후 재사용한다(Pitfall 3).
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.ghtrade.app",
      team_id: "954QPCS3F5",
      readonly: false,
      output_path: out
    )

    ipa = build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      # fastlane 2.240.1 gym 은 app-store-connect 를 거부한다 — Xcode 27 은 app-store 를 받는다.
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: "954QPCS3F5",
        provisioningProfiles: { "com.ghtrade.app" => lane_context[SharedValues::SIGH_NAME] }
      },
      # 자동 서명은 Xcode › Settings › Accounts 에 로그인된 팀 954QPCS3F5 Apple ID 로 개발 인증서·프로파일을
      # 받는다(README 「처음 1회」 · 22-REVIEW WR-05). -authenticationKey* 로 ASC 키를 넘기지 않는 이유:
      # gym 이 xcodebuild 명령줄을 그대로 로그에 찍어 키 ID·발급자 ID 가 터미널·로그에 남는다(값 비출력 규약).
      xcargs: "CODE_SIGN_STYLE=Automatic CURRENT_PROJECT_VERSION=#{build_number} -allowProvisioningUpdates",
      output_directory: out,
      output_name: "App",
      clean: true
    )

    # 업로드 전 게이트 — 실패하면 sh 가 예외를 던져 lane 이 멈춘다(업로드 안 함).
    # 서명 팀 · application-identifier(-34018) · get-task-allow · CAPACITOR_DEBUG · 빌드 번호 · 운영 URL.
    sh("bash", File.expand_path("../../../scripts/check-ipa.sh", __dir__), File.expand_path(ipa), build_number)

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa, # 검사한 바로 그 IPA 를 올린다
      skip_waiting_for_build_processing: true
    )
  end

  desc "조회 전용: 최신 TestFlight 빌드 번호 + 처리 상태 (업로드 없음)"
  lane :latest do
    # 값은 출력하지 않는다 — 비어 있는 키 이름만. 산출 경로는 쓰지 않으므로 검사하지 않는다.
    missing = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH].select { |k| ENV[k].to_s.empty? }
    UI.user_error!("환경변수 비어 있음: #{missing.join(' ')} — ~/.config/gh-trade/release/ios.env") unless missing.empty?

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
      in_house: false
    )

    number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.ghtrade.app"
    )

    # Spaceship 인자는 설치된 2.240.1 에서 실행으로 확인했다:
    #   Build.all(client:, app_id:, version:, build_number:, platform:, processing_states:, includes:, sort:, limit:)
    #   Build::ProcessingState = INVALID · PROCESSING · FAILED · VALID
    Spaceship::ConnectAPI.token ||= Spaceship::ConnectAPI::Token.from(hash: api_key)
    app = Spaceship::ConnectAPI::App.find("com.ghtrade.app")
    build = app && Spaceship::ConnectAPI::Build.all(app_id: app.id, build_number: number.to_s).find do |b|
      b.version.to_s == number.to_s
    end
    state = build ? build.processing_state : "UNKNOWN"

    UI.message("latest TestFlight build #{number} state #{state}")
  end
end
