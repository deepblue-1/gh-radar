# Kyobo SecuwaySSL VPN — persistent DMA tunnel on radar-gw.
# Split-route only: the login response installs host routes
# 10.16.207.112/.119/.127 via 10.212.0.1 on tun1 — refreshed only on reconnect
# (systemctl restart securwayssl); .127 quick-260928-ei9. No redirect-gateway,
# so the default route (ens4), KB tun0 and wg0 are untouched. Credentials come
# from Secret Manager via ExecStartPre; the value never lands in the unit,
# args, or logs.
#
# PROCESS MODEL: SecuwaySSLU_client is a launcher that spawns the sbin/sslvpn
# tunnel daemon and returns. secuway-connect (ExecStart) backgrounds it and
# then blocks on sslvpn, so this Type=simple service's MainPID lives exactly as
# long as the tunnel — sslvpn death exits ExecStart and Restart=always
# reconnects. KillMode=control-group tears down launcher + sslvpn on stop.
#
# RETRY POLICY (quick-261007-b9o): secuway-connect fails fast (exit 1) as soon
# as the client prints an `Error:` line (e.g. 「이미 로그인한 사용자입니다」), so
# systemd retries after RestartSec=10. 10s is a FLOOR — the account shares a
# registered MAC with the desktop client and the lockout policy for repeated
# logins is unknown, so never hammer below it. StartLimitBurst=8 per 600s: the
# server can hold the previous session ~60s (10-07: rejected 23:02:11Z, accepted
# 23:03:11Z), which needs ~6 starts at a ~14-17s cycle (RestartSec 10 +
# fetch-secret + login); 5 would drop to failed inside that window. Once the
# limit is exhausted the unit is `failed`; secuway-watchdog recovers it at most
# once per hour (reset-failed + start). It NEVER starts an `inactive` unit — a
# human `systemctl stop` means the desktop client is in use (mutual exclusion).
#
# DEPLOY: changing this unit needs only daemon-reload — it takes effect on the
# next (re)connect. Do NOT restart securwayssl during market hours
# (08:00~20:00 KST); deploy after 20:00 and avoid the 21:00~21:20 limitup-pull
# transfer window. See infra/relay/README.md (§교보 SecuwaySSL VPN).
#
# ⚠ Same registered device MAC as the desktop client. Do NOT run both at once —
# Kyobo may drop one session or lock the account. See infra/relay/README.md.
[Unit]
Description=Kyobo SecuwaySSL VPN client (DMA split-route tunnel)
Documentation=file:///opt/SecurwaySSL
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=8

[Service]
Type=simple
ExecStartPre=/usr/local/sbin/secuway-fetch-secret
ExecStart=/usr/local/sbin/secuway-connect
ExecStopPost=-/bin/rm -f /run/secuway.cred /run/secuway-connect.err
Restart=always
RestartSec=10
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
