#!/bin/bash
# ExecStartPre for securwayssl.service — fetch Kyobo SecuwaySSL credentials
# from Secret Manager into a root-only tmpfs file. Mirrors kbvpn-fetch-secret.
# The credential VALUE is never echoed or logged.
set -euo pipefail
SECRET=kyobo-vpn-cred
PROJECT=gh-radar
CRED=/run/secuway.cred
umask 077
gcloud secrets versions access latest --secret="$SECRET" --project="$PROJECT" > "$CRED"
chmod 600 "$CRED"
# Sanity: must be at least two non-empty lines (User ID, Password)
if [ "$(grep -c . "$CRED" 2>/dev/null || echo 0)" -lt 2 ]; then
  echo "secuway-fetch-secret: cred file malformed (need id+password lines)" >&2
  rm -f "$CRED"
  exit 1
fi
