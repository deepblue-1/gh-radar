# ═══════════════════════════════════════════════════════════════
# gh-radar DMA relay — Caddy 리버스 프록시 (Phase 15 RELAY-03 · D-05)
# 배치 위치: /etc/caddy/Caddyfile
#
# ── 운영 주의 ────────────────────────────────────────────────────
# ① WebSocket 설정이 따로 필요 없다.
#    Caddy v2 는 Upgrade 헤더를 감지해 리버스 프록시로 자동 통과시킨다.
#    v1 시절의 `websocket` 지시어나 별도 헤더 전달 설정을 넣지 말 것.
#
# ② 포트 80 을 열지 않아도 인증서가 발급된다.
#    HTTP-01(80) 과 TLS-ALPN-01(443) 중 하나면 충분하고, 443 만 열려 있으면
#    TLS-ALPN-01 로 발급된다. D-09 의 "공인 인바운드는 443 만" 과 정합.
#    최초 발급이 계속 실패할 때만 80 을 임시 개방했다가 발급 후 방화벽 규칙을 지운다.
#
# ③ **장중에 이 파일을 바꾸지 말 것.**
#    설정 리로드 시 진행 중인 WebSocket 연결이 강제 종료된다.
#    불가피하면 reverse_proxy 에 `stream_close_delay` 를 주고 장 종료 후에 반영한다.
#
# ④ 접근 로그에 토큰이 남지 않는다.
#    인증 토큰은 wss 첫 메시지 본문으로만 오가고 URL·쿼리스트링에 없다(D-11).
#    Caddy 는 기본적으로 Authorization·Cookie 헤더를 로그에서 가린다 — 그 기본값을 유지한다.
#    커스텀 로그 포맷으로 헤더를 통째로 찍는 설정을 추가하지 말 것.
#
# ⑤ ACME 계정 이메일은 **선택 항목**이라 이 파일에 전역 옵션 블록을 두지 않는다.
#    예전에는 전역 블록에서 환경변수 placeholder 로 email 을 받았으나, 변수가 비면 인자 0개짜리
#    `email` 로 전개돼 **설정 파싱이 통째로 실패**했다(Caddy 가 아예 기동하지 않는다).
#    이메일을 넣고 싶으면 인스턴스 메타데이터 `caddy-email` 을 주면 startup.sh 가
#    이 파일 앞에 전역 블록을 붙여 준다. 없으면 만료 알림 없이 정상 발급된다.
# ═══════════════════════════════════════════════════════════════

dma.jx1.io {
	# 포트 80 은 D-09 에 따라 **영구 차단**이므로 HTTP-01 챌린지는 절대 성공할 수 없다.
	# 명시적으로 꺼 두지 않으면 Caddy 가 갱신 때마다 HTTP-01 을 먼저 시도해
	# 실패 검증을 누적시킨다(Let's Encrypt 는 hostname 당 시간당 실패 5회 제한 — T-15-13).
	# 443 만으로 발급되는 TLS-ALPN-01 로 고정한다.
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	encode zstd gzip

	# 공개 헬스 — relay 내부 포트의 헬스만 노출한다.
	# 세션 수·VPN 상태 요약이며 PII·계좌번호는 포함하지 않는다.
	# Cloud Monitoring uptime check 대상.
	handle /healthz {
		reverse_proxy 127.0.0.1:8091
	}

	# ── /ghtrade/* — gh-trade WinForms 클라 자동 업데이트 정적 배포 (quick-260911-dps) ──
	#
	# **배치 순서가 곧 안전장치다.** `handle` 과 `handle_path` 는 서로 상호 배타적이라
	# 같은 그룹에서 위에서부터 **첫 일치 하나만** 실행된다. 바로 아래의 매처 없는 기본
	# `handle` 은 **모든 경로**에 일치하므로, 이 세 블록이 그 뒤로 내려가면 `/ghtrade/*`
	# 요청이 relay wss 프록시(= 주문 경로)로 흘러들고 정적 파일은 영원히 나오지 않는다.
	# 자리는 반드시 `handle /healthz` **뒤** · 기본 `handle` **앞** 이다. 옮기지 말 것.
	#
	# **불일치·부재는 401 이 아니라 404 다.** 401 은 "여기 뭔가 있다" 를 알려 준다.
	# 이 표면은 존재 자체를 숨긴다 — 미인증 `/ghtrade` · `/ghtrade/*` 는 전부 404.
	#
	# **이 고정키가 왜 비밀이 아닌가 (Phase 15 SC-8 "비밀 미기록" 오독 방지).**
	#   ① 무결성은 이 키가 담당하지 않는다 — 클라가 manifest 의 RSA-SHA256 서명을
	#      검증한다(gh-trade D-09). 이 키가 새어도 가짜 exe 를 밀어 넣을 수 없다.
	#   ② 이 키의 용도는 무관한 접근·크롤러 차단과 존재 은닉(404) 뿐이다.
	#   ③ **양쪽 저장소의 소스 상수여야만 동작한다**(D-11) — 같은 문자열이 gh-trade
	#      클라에 컴파일돼 이미 배포된 exe 안에 실려 나간다. Secret Manager 로 옮겨도
	#      비밀성이 생기지 않고, 한쪽만 바꾸면 전 클라가 404 를 받는다.
	#   ④ **SC-8 이 막은 것은 접속 자격증명이다.** quick-260908-py9 가 저장소의 KB VPN
	#      계정 ID 를 마스킹해 그 조항을 닫았고, 실제 접속 비밀 값은 지금도 Secret
	#      Manager 와 VM `/etc/kbvpn.env`(0600) 에만 있다. 이 Bearer 값은 그 범주가 아니다.
	#   ⑤ 그래도 **로그에는 남지 않는다** — 이 값을 `Authorization: Bearer` 형식으로
	#      받는 것 자체가 위 상단 주석 ④ 의 Caddy 기본 헤더 마스킹을 이용하려는
	#      선택이다(D-11). 그 기본값을 유지할 것(커스텀 로그 포맷 금지).
	#
	# **교체 비용.** 키를 바꾸려면 배포된 모든 클라를 갱신해야 한다(D-11/D-12).
	# 그래서 회전이 아니라 서명에 무결성을 의존하는 설계다.
	#
	# `header` 매처는 값에 `*` 가 없으면 **정확 일치**다 — 그래서 아래 한 줄로
	# "정확히 일치할 때만 서빙" 이 성립한다.
	@ghtrade_deny {
		path /ghtrade /ghtrade/*
		not header Authorization "Bearer bf99d2e2310ad4954951535ee893cceb318487729f28307a"
	}
	handle @ghtrade_deny {
		respond 404
	}

	# 인증을 통과한 요청만 여기로 온다.
	#
	# **접두어 제거 시점 주의.** `handle_path` 는 블록 안쪽 지시어·매처가 평가되기
	# **전에** `/ghtrade` 를 떼어 낸다. 따라서 아래 `@ghtrade_nostore` 의 `path` 는
	# 제거 후 기준(`/manifest.json`)으로 적어야 한다 — `/ghtrade/manifest.json` 으로
	# 적으면 오류 없이 조용히 안 맞고 캐시 헤더만 사라진다.
	#
	# **캐시.** manifest 2종에만 `no-store`. 클라는 이 둘로 "무엇이 바뀌었나" 를
	# 판단하므로 캐시된 옛 manifest 를 받으면 업데이트가 조용히 멈춘다. 나머지 파일은
	# 내용이 바뀌면 파일명·해시가 달라지므로 기본 캐시 동작으로 충분하다.
	#
	# **디렉터리 목록.** `file_server` 는 목록 옵션을 주지 않는 한 디렉터리를 나열하지
	# 않는다. 여기서는 **의도적으로 주지 않았다** — 나중에 편의로 켜면 배포 파일 전체
	# 목록이 공개된다. 켜지 말 것.
	#
	# `/srv/ghtrade` 는 startup.sh 가 매 부팅 준비한다(디렉터리만 — 내용물은 gh-trade
	# 발행 스크립트가 IAP scp 로 올린다). 경로 문자열이 두 파일에서 같아야 한다.
	handle_path /ghtrade/* {
		root * /srv/ghtrade
		@ghtrade_nostore path /manifest.json /manifest.sig
		header @ghtrade_nostore Cache-Control no-store
		file_server
	}

	# 인증은 됐으나 파일을 지목하지 않은 **정확 경로** `/ghtrade`.
	# `handle_path /ghtrade/*` 는 이 경로에 일치하지 않으므로, 이 블록이 없으면
	# 이 요청 하나만 아래 기본 `handle` 로 흘러 relay wss 프록시에 닿는다.
	handle /ghtrade {
		respond 404
	}

	# 기본 라우트 — relay wss 팬아웃.
	handle {
		reverse_proxy 127.0.0.1:8090
	}

	log {
		output file /var/log/caddy/dma.log
		format json
	}
}
