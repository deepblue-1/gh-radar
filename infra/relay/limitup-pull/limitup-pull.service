# limitup-pull.service — 119 상한가 밤 export → GCS 운반 (oneshot, Phase 28 D-13 · docs/relay-operations.md)
#
# radar-gw 전용이다 — install.sh 가 그대로 /etc/systemd/system/ 에 복사한다(자리표시자 없음).
# limitup-pull.timer 가 평일 21:00 KST 에 Unit= 으로 부른다 — 이 유닛에는 [Install] 이 없다(직접 enable 하지 않는다).
# 입력은 119 ~/ticks/export(rrsync 읽기 전용 키 radar-gw-pull), 출력은 /etc/limitup-pull.env 의 BUCKET 아래 export/.
# 적재(manifest sha256 대조 · 날짜 단위 교체)는 Cloud Run Job gh-radar-limitup-sync(21:20)가 한다 — 여기는 운반만.
#
# 재시작 없음 — 상태 없이 미러와 버킷을 매 회차 맞추므로 실패한 회차는 다음 평일 21:00 이 보충한다.
# 실패는 journald(`journalctl -u limitup-pull`)의 `[limitup-pull] dates=… rsync=… upload=…` 요약 줄과 비영 종료로 남는다.
#
# 자원 상한 — radar-gw 는 gh-radar relay 가 도는 e2-small(2GB)이다. relay 에 양보한다:
#   Nice 19 · IO idle · MemoryMax 300M(하루 약 4MB 의 작은 파일들 — tick-archive 600M 의 절반) ·
#   OOMScoreAdjust 500(메모리가 모자라면 relay 보다 먼저 죽는다) · gcloud 1 프로세스 · 2 스레드 · 합성 업로드 끔.
[Unit]
Description=limitup-pull - 119 limit-up nightly export to GCS (docs/relay-operations.md)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=limitpull
Group=limitpull
EnvironmentFile=/etc/limitup-pull.env
Environment=CLOUDSDK_CORE_DISABLE_PROMPTS=1
Environment=CLOUDSDK_STORAGE_PARALLEL_COMPOSITE_UPLOAD_ENABLED=False
Environment=CLOUDSDK_STORAGE_PROCESS_COUNT=1
Environment=CLOUDSDK_STORAGE_THREAD_COUNT=2
ExecStart=/usr/local/lib/limitup-pull/limitup-pull.sh
Nice=19
IOSchedulingClass=idle
MemoryMax=300M
OOMScoreAdjust=500
# 첫 회차는 119 에 쌓인 날짜 전부(수십 MB)를 받는다 — 1시간이면 넉넉하다. 초과하면 다음 회차가 잇는다
TimeoutStartSec=1h
