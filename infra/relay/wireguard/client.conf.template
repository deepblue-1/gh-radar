# ═══════════════════════════════════════════════════════════════
# KB DMA — WireGuard 클라이언트 프로필 템플릿 (Mac / Windows 공용)
#
# ── 저장 방법 ───────────────────────────────────────────────────
#   이 파일을 채워 **`KB DMA.conf`** 라는 파일명으로 저장한 뒤 WireGuard 공식 앱에
#   import 한다. **파일명이 곧 터널 이름**이므로 다른 이름으로 저장하면
#   `scutil --nc list` 에 `KB DMA` 가 뜨지 않고 macOS 메뉴바 앱이 제어하지 못한다.
#
# ── 개인키를 여기에 쓰지 않는다 ────────────────────────────────
#   권장 절차는 앱의 「빈 터널 만들기 (Add empty tunnel)」로 **앱이 키쌍을 생성**하게
#   하고, 화면에 뜬 **공개키만** 관리자에게 전달하는 것이다. 그러면 개인키는
#   개발기 키체인 밖으로 한 번도 나가지 않는다. 이 파일에는 실키를 절대 적지 않는다.
#   (템플릿을 직접 채워 import 하는 경우에도, 채운 파일은 저장소에 넣지 않는다.)
#
# ── 발급 절차 · 검증 · 막힐 때 ─────────────────────────────────
#   infra/relay/README.md §DMA 터널 → A. WireGuard 직결 (기본)
# ═══════════════════════════════════════════════════════════════

[Interface]
# 앱이 생성한 개인키. 아래 플레이스홀더를 그대로 두면 앱이 import 를 거부한다.
PrivateKey = <CLIENT_PRIVATE_KEY>
# 관리자가 배정한 주소. 서버가 10.20.0.1 이므로 <N> 은 2~254.
Address = 10.20.0.<N>/32

[Peer]
# radar-gw 의 서버 공개키. 관리자가 `sudo wg show wg0 public-key` 로 알려준다.
PublicKey = <SERVER_PUBLIC_KEY>
Endpoint = dma.jx1.io:51820
# ⚠️ AllowedIPs 가 /32 **하나뿐**인 것이 핵심이다.
#    이 프로필은 게이트웨이 한 대로 가는 경로만 만들고,
#    기본 경로(0.0.0.0/0)도 사내망의 나머지 대역도 가져가지 않는다.
#    즉 터널을 켜 둔 채로 평소 인터넷·사내 자원을 그대로 쓴다.
AllowedIPs = 10.41.1.120/32
# NAT/공유기 뒤에서 세션이 조용히 죽는 것을 막는다 (서버→클라이언트 방향 유지).
PersistentKeepalive = 25
